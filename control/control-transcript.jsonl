foreEach\n    public void setUp() throws Exception {\n        // Counters are static in HealthResource, so reset them between tests\n        setField(null, \"messageLastTotal\", 0L);\n        setField(null, \"messageLastCheck\", 0L);\n\n        config = mock(Config.class);\n        statisticsManager = mock(StatisticsManager.class);\n        storage = mock(Storage.class);\n\n        resource = new HealthResource();\n        setField(resource, \"config\", config);\n        setField(resource, \"statisticsManager\", statisticsManager);\n        setField(resource, \"storage\", storage);\n    }\n\n    @Test\n    public void testOkWhenStorageAnswers() throws Exception {\n        when(storage.getObject(eq(Server.class), any())).thenReturn(new Server());\n\n        Response response = resource.health();\n\n        assertEquals(Response.Status.OK.getStatusCode(), response.getStatus());\n        assertEquals(\"OK\", response.getEntity());\n    }\n\n    @Test\n    public void testErrorWhenStorageThrows() throws Exception {\n        when(storage.getObject(eq(Server.class), any())).thenThrow(new StorageException(\"database down\"));\n\n        Response response = resource.health();\n\n        assertEquals(Response.Status.INTERNAL_SERVER_ERROR.getStatusCode(), response.getStatus());\n    }\n\n    @Test\n    public void testErrorWhenMessagesDropBelowThreshold() throws Exception {\n        when(config.getDouble(Keys.WEB_HEALTH_CHECK_DROP_THRESHOLD)).thenReturn(0.5);\n        when(storage.getObject(eq(Server.class), any())).thenReturn(new Server());\n        // Increments: 100, 100, then 10 (ratio 0.1 < 0.5)\n        when(statisticsManager.messageStoredCount()).thenReturn(100, 200, 210);\n\n        assertEquals(Response.Status.OK.getStatusCode(), resource.health().getStatus());\n        assertEquals(Response.Status.OK.getStatusCode(), resource.health().getStatus());\n        assertEquals(Response.Status.INTERNAL_SERVER_ERROR.getStatusCode(), resource.health().getStatus());\n    }\n\n    @Test\n    public void testOkWhenMessagesAboveThreshold() throws Exception {\n        when(config.getDouble(Keys.WEB_HEALTH_CHECK_DROP_THRESHOLD)).thenReturn(0.5);\n        when(storage.getObject(eq(Server.class), any())).thenReturn(new Server());\n        // Increments: 100, 100, then 60 (ratio 0.6 >= 0.5)\n        when(statisticsManager.messageStoredCount()).thenReturn(100, 200, 260);\n\n        assertEquals(Response.Status.OK.getStatusCode(), resource.health().getStatus());\n        assertEquals(Response.Status.OK.getStatusCode(), resource.health().getStatus());\n        assertEquals(Response.Status.OK.getStatusCode(), resource.health().getStatus());\n    }\n\n    @Test\n    public void testOkWhenNoThresholdSet() throws Exception {\n        // Mocked config returns 0.0, the same as an unset key\n        when(storage.getObject(eq(Server.class), any())).thenReturn(new Server());\n        when(statisticsManager.messageStoredCount()).thenReturn(100, 200, 210);\n\n        assertEquals(Response.Status.OK.getStatusCode(), resource.health().getStatus());\n        assertEquals(Response.Status.OK.getStatusCode(), resource.health().getStatus());\n        assertEquals(Response.Status.OK.getStatusCode(), resource.health().getStatus());\n    }\n\n}\n","structuredPatch":[{"oldStart":10,"oldLines":7,"newStart":10,"newLines":6,"lines":[" import org.traccar.storage.StorageException;"," "," import jakarta.ws.rs.core.Response;","-"," import java.lang.reflect.Field;"," "," import static org.junit.jupiter.api.Assertions.assertEquals;"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01EgRvr3oUj9KG38Rxe3QYzu","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
