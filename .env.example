# Traccar reads its configuration from an XML file (debug.xml locally, setup/traccar.xml when
# packaged). Environment variables are read only when CONFIG_USE_ENVIRONMENT_VARIABLES=true
# (or config.useEnvironmentVariables=true in the XML file). See src/main/java/org/traccar/config/Config.java.
#
# Any key in src/main/java/org/traccar/config/Keys.java maps to an environment variable:
# dots become underscores, camelCase gets an underscore, everything is upper case.
#   database.url          -> DATABASE_URL
#   logger.fullStackTraces -> LOGGER_FULL_STACK_TRACES
#   web.port              -> WEB_PORT
# Environment variables override the values in the XML file.
#
# The server does not load a .env file itself. Export the variables in your shell
# (for example `set -a; . ./.env; set +a`) before `make dev`.

CONFIG_USE_ENVIRONMENT_VARIABLES=true

# Database. Default: the embedded H2 file database used by debug.xml.
DATABASE_DRIVER=org.h2.Driver
DATABASE_URL=jdbc:h2:./target/database
DATABASE_USER=sa
DATABASE_PASSWORD=

# PostgreSQL from compose.yaml (make db-up):
# DATABASE_DRIVER=org.postgresql.Driver
# DATABASE_URL=jdbc:postgresql://localhost:5432/traccar
# DATABASE_USER=traccar
# DATABASE_PASSWORD=traccar

# MySQL from compose.yaml (make db-up):
# DATABASE_DRIVER=com.mysql.cj.jdbc.Driver
# DATABASE_URL=jdbc:mysql://localhost:3306/traccar?serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false&allowMultiQueries=true
# DATABASE_USER=traccar
# DATABASE_PASSWORD=traccar

# Web server port (default 8082).
# WEB_PORT=8082

# Logging (default level: info).
# LOGGER_LEVEL=info
# LOGGER_FULL_STACK_TRACES=true
