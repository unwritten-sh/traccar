r, skipped: number, failed: number): void => {\n    const key = `${current}:${ran}:${skipped}:${failed}`\n    if (seen.has(key)) return\n    seen.add(key)\n    found = true\n    sum.ran += ran\n    sum.skipped += skipped\n    sum.failed += failed\n  }\n  current = 'pytest'\n  // pytest: \"== 59 passed, 2 skipped in 1.2s ==\" (the final line only). With -q the line has no \"=\".\n  for (const m of output.matchAll(\n    /^(?:=+ )?(\\d+ (?:passed|failed|skipped|errors?|deselected|xfailed|xpassed)\\b.*) in [\\d.]+s\\b.*$/gm,\n  )) {\n    const line = m[1] ?? ''\n    const g = (w: string): number => num(new RegExp(`(\\\\d+) ${w}`).exec(line)?.[1])\n    add(g('passed') + g('failed') + g('skipped') + g('errors?'), g('skipped'), g('failed') + g('errors?'))\n  }\n  current = 'unittest'\n  // Django and unittest: \"Ran 37 tests in 4.2s\" then \"OK (skipped=14)\" or \"FAILED (failures=1)\"\n  for (const m of output.matchAll(/^Ran (\\d+) tests? in [\\d.]+s\\s*\\n+\\s*(OK|FAILED)(?: \\(([^)]*)\\))?/gm)) {\n    const detail = m[3] ?? ''\n    add(\n      num(m[1]),\n      num(/skipped=(\\d+)/.exec(detail)?.[1]),\n      num(/failures=(\\d+)/.exec(detail)?.[1]) + num(/errors=(\\d+)/.exec(detail)?.[1]),\n    )\n  }\n  current = 'jest'\n  // Jest: \"Tests:       1 failed, 2 skipped, 30 passed, 33 total\"\n  for (const m of output.matchAll(/^Tests:\\s+(.*?)(\\d+) total/gm)) {\n    const line = m[1] ?? ''\n    add(num(m[2]), num(/(\\d+) skipped/.exec(line)?.[1]), num(/(\\d+) failed/.exec(line)?.[1]))\n  }\n  current = 'vitest'\n  // Vitest: \"      Tests  31 passed | 2 skipped (33)\"\n  for (const m of output.matchAll(/^\\s*Tests\\s+(.*)\\((\\d+)\\)\\s*$/gm)) {\n    const line = m[1] ?? ''\n    add(num(m[2]), num(/(\\d+) skipped/.exec(line)?.[1]), num(/(\\d+) failed/.exec(line)?.[1]))\n  }\n  current = 'surefire'\n  // Maven Surefire summary: \"Tests run: 12, Failures: 0, Errors: 0, Skipped: 1\" after \"Results:\"\n  const surefire = [\n    ...output.matchAll(/^\\[?\\w*\\]?\\s*Tests run: (\\d+), Failures: (\\d+), Errors: (\\d+), Skipped: (\\d+)\\s*$/gm),\n  ]\n  const last = surefire.at(-1)\n  if (last) add(num(last[1]), num(last[4]), num(last[2]) + num(last[3]))\n  current = 'cargo'\n  // Cargo: \"test result: ok. 10 passed; 0 failed; 1 ignored\"\n  for (const m of output.matchAll(/test result: \\w+\\. (\\d+) passed; (\\d+) failed; (\\d+) ignored/g)) {\n    add(num(m[1]) + num(m[2]) + num(m[3]), num(m[3]), num(m[2]))\n  }\n  current = 'rspec'\n  // RSpec: \"42 examples, 0 failures, 3 pending\"\n  for (const m of output.matchAll(/(\\d+) examples?, (\\d+) failures?(?:, (\\d+) pending)?/g)) {\n    add(num(m[1]), num(m[3]), num(m[2]))\n  }\n  current = 'minitest'\n  // Minitest (Rails): \"2978 runs, 12393 assertions, 0 failures, 0 errors, 43 skips\"\n  for (const m of output.matchAll(\n    /^(\\d+) runs, \\d+ assertions, (\\d+) failures, (\\d+) errors, (\\d+) skips/gm,\n  )) {\n    add(num(m[1]), num(m[4]), num(m[2]) + num(m[3]))\n  }\n  current = 'phpunit'\n  // PHPUnit: \"OK (12 tests, 30 assertions)\" or \"Tests: 12, Assertions: 30, Skipped: 1.\"\n  for (const m of output.matchAll(/^OK \\((\\d+) tests?,/gm)) add(num(m[1]), 0, 0)\n  for (const m of output.matchAll(/^Tests: (\\d+), Assertions: \\d+(.*)$/gm)) {\n    const line = m[2] ?? ''\n    add(num(m[1]), num(/Skipped: (\\d+)/.exec(line)?.[1]), num(/Failures: (\\d+)/.exec(line)?.[1]))\n  }\n  current = 'mocha'\n  // Mocha: \"  12 passing (30ms)\", \"  1 pending\"\n  for (const m of output.matchAll(/^\\s+(\\d+) passing \\(/gm)) {\n    const pending = num(/^\\s+(\\d+) pending/m.exec(output)?.[1])\n    add(num(m[1]) + pending, pending, num(/^\\s+(\\d+) failing/m.exec(output)?.[1]))\n  }\n  current = 'go'\n  // Go: one \"ok  pkg  0.1s\" line per package; counts packages, not tests.\n  const goPackages = output.match(/^ok\\s+\\S+\\s+[\\d.]+s/gm)\n  if (goPackages) add(goPackages.length, 0, 0)\n  return found ? sum : null\n}\n\nconst PREFIX: Record<TaskRunnerKind, string> = {\n  make: 'make',\n  just: 'just',\n  task: 'task',\n  npm: 'npm run',\n  maven: 'mvn -B',\n  gradle: './gradlew',\n  cargo: 'cargo',\n  composer: 'composer run',\n  rake: 'rake',\n}\n\n/** The gate commands of a repository, from its task runner, when no state.json declares them. */\nexport function inferGates(repo: Repo): Gates {\n  const command = (names: string[]): string | null => {\n    for (const r of repo.runners()) {\n      const t = names.find((n) => r.targets.includes(n))\n      if (t) {\n        const prefix = r.kind === 'gradle' && !repo.has('gradlew') ? 'gradle' : PREFIX[r.kind]\n        return `${prefix} ${t}`\n      }\n    }\n    return null\n  }\n  const buildTool = repo.runners().some((r) => ['maven', 'gradle', 'cargo'].includes(r.kind))\n  return {\n    setup: command(['setup', 'init', 'install']),","numLines":140,"startLine":20,"totalLines":200}},"tool_result_meta":[{"id":"toolu_01YSscNG9XkWB9TNsLodP8uA","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
