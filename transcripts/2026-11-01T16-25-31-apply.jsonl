w RegExp(`(\\\\d+) ${w}`).exec(line)?.[1])\n65\t    add(g('passed') + g('failed') + g('skipped') + g('errors?'), g('skipped'), g('failed') + g('errors?'))\n66\t  }\n67\t  current = 'unittest'\n68\t  // Django and unittest: \"Ran 37 tests in 4.2s\" then \"OK (skipped=14)\" or \"FAILED (failures=1)\"\n69\t  for (const m of output.matchAll(/^Ran (\\d+) tests? in [\\d.]+s\\s*\\n+\\s*(OK|FAILED)(?: \\(([^)]*)\\))?/gm)) {\n70\t    const detail = m[3] ?? ''\n71\t    add(\n72\t      num(m[1]),\n73\t      num(/skipped=(\\d+)/.exec(detail)?.[1]),\n74\t      num(/failures=(\\d+)/.exec(detail)?.[1]) + num(/errors=(\\d+)/.exec(detail)?.[1]),\n75\t    )\n76\t  }\n77\t  current = 'jest'\n78\t  // Jest: \"Tests:       1 failed, 2 skipped, 30 passed, 33 total\"\n79\t  for (const m of output.matchAll(/^Tests:\\s+(.*?)(\\d+) total/gm)) {\n80\t    const line = m[1] ?? ''\n81\t    add(num(m[2]), num(/(\\d+) skipped/.exec(line)?.[1]), num(/(\\d+) failed/.exec(line)?.[1]))\n82\t  }\n83\t  current = 'vitest'\n84\t  // Vitest: \"      Tests  31 passed | 2 skipped (33)\"\n85\t  for (const m of output.matchAll(/^\\s*Tests\\s+(.*)\\((\\d+)\\)\\s*$/gm)) {\n86\t    const line = m[1] ?? ''\n87\t    add(num(m[2]), num(/(\\d+) skipped/.exec(line)?.[1]), num(/(\\d+) failed/.exec(line)?.[1]))\n88\t  }\n89\t  current = 'surefire'\n90\t  // Maven Surefire summary: \"Tests run: 12, Failures: 0, Errors: 0, Skipped: 1\" after \"Results:\"\n91\t  const surefire = [\n92\t    ...output.matchAll(/^\\[?\\w*\\]?\\s*Tests run: (\\d+), Failures: (\\d+), Errors: (\\d+), Skipped: (\\d+)\\s*$/gm),\n93\t  ]\n94\t  const last = surefire.at(-1)\n95\t  if (last) add(num(last[1]), num(last[4]), num(last[2]) + num(last[3]))\n96\t  current = 'cargo'\n97\t  // Cargo: \"test result: ok. 10 passed; 0 failed; 1 ignored\"\n98\t  for (const m of output.matchAll(/test result: \\w+\\. (\\d+) passed; (\\d+) failed; (\\d+) ignored/g)) {\n99\t    add(num(m[1]) + num(m[2]) + num(m[3]), num(m[3]), num(m[2]))\n100\t  }\n101\t  current =