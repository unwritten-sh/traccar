ntCheck > 0) {\n                double ratio = messageCurrentCheck / (double) messagePreviousCheck;\n                if (ratio < dropThreshold) {\n                    throw new IllegalStateException(\"Message health check failed with ratio \" + ratio);\n                }\n            }\n        }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01961wnq82gi8gbCj8F2AfZB","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
