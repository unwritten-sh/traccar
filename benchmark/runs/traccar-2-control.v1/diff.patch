@@ -0,0 +1,143 @@
+package org.traccar.protocol;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.ProtocolTest;
+import org.traccar.model.Command;
+
+public class JmakProtocolEncoderTest extends ProtocolTest {
+
+    private Command command(String type) {
+        Command command = new Command();
+        command.setDeviceId(1);
+        command.setType(type);
+        return command;
+    }
+
+    @Test
+    public void testEncodeData() throws Exception {
+
+        var channel = channel(inject(new JmakProtocolEncoder(null, false)));
+
+        Command command = command(Command.TYPE_CUSTOM);
+        command.set(Command.KEY_DATA, "$2;60;#");
+        verifyEncode(channel, command, text("$2;60;#"));
+
+        verifyEncode(channel, command(Command.TYPE_ENGINE_STOP), text("$34;1;#"));
+
+        verifyEncode(channel, command(Command.TYPE_ENGINE_RESUME), text("$34;0;#"));
+
+        command = command(Command.TYPE_OUTPUT_CONTROL);
+        command.set(Command.KEY_INDEX, 1);
+        command.set(Command.KEY_DATA, "1");
+        verifyEncode(channel, command, text("$34;1;#"));
+
+        command = command(Command.TYPE_OUTPUT_CONTROL);
+        command.set(Command.KEY_INDEX, 2);
+        command.set(Command.KEY_DATA, "0");
+        verifyEncode(channel, command, text("$94;0;#"));
+
+        command = command(Command.TYPE_OUTPUT_CONTROL);
+        command.set(Command.KEY_INDEX, 3);
+        command.set(Command.KEY_DATA, "1");
+        verifyEncode(channel, command, text("$167;1;#"));
+
+        command = command(Command.TYPE_POSITION_PERIODIC);
+        command.set(Command.KEY_FREQUENCY, 60);
+        verifyEncode(channel, command, text("$2;60;#"));
+
+        command = command(Command.TYPE_SET_ODOMETER);
+        command.set(Command.KEY_DATA, "12345");
+        verifyEncode(channel, command, text("$30;12345;#"));
+
+        command = command(Command.TYPE_SET_CONNECTION);
+        command.set(Command.KEY_SERVER, "jmak.com.br");
+        command.set(Command.KEY_PORT, 5259);
+        verifyEncode(channel, command, text("$43;jmak.com.br;|12;5259;#"));
+
+        command = command(Command.TYPE_SET_CONNECTION);
+        command.set(Command.KEY_SERVER, "191.233.246.121");
+        command.set(Command.KEY_PORT, 5259);
+        verifyEncode(channel, command, text("$13;191.233.246.121;|12;5259;#"));
+
+        verifyEncode(channel, command(Command.TYPE_REBOOT_DEVICE), text("$93;1;#"));
+
+        command = command(Command.TYPE_SET_SPEED_LIMIT);
+        command.set(Command.KEY_DATA, "80");
+        verifyEncode(channel, command, text("$16;1;|17;80;#"));
+
+        command = command(Command.TYPE_ALARM_BATTERY);
+        command.set(Command.KEY_ENABLE, true);
+        verifyEncode(channel, command, text("$57;1;#"));
+
+        command = command(Command.TYPE_ALARM_REMOVE);
+        command.set(Command.KEY_ENABLE, false);
+        verifyEncode(channel, command, text("$55;0;#"));
+
+        command = command(Command.TYPE_ALARM_GEOFENCE);
+        command.set(Command.KEY_DATA, "1");
+        verifyEncode(channel, command, text("$59;1;#"));
+
+    }
+
+    @Test
+    public void testEncodeSms() throws Exception {
+
+        var channel = channel(inject(new JmakProtocolEncoder(null, true)));
+
+        Command command = command(Command.TYPE_CUSTOM);
+        command.set(Command.KEY_DATA, "JMAK#s;2;60#");
+        verifyEncode(channel, command, text("JMAK#s;2;60#"));
+
+        verifyEncode(channel, command(Command.TYPE_ENGINE_STOP), text("JMAK#s;34;1#"));
+
+        verifyEncode(channel, command(Command.TYPE_ENGINE_RESUME), text("JMAK#s;34;0#"));
+
+        command = command(Command.TYPE_OUTPUT_CONTROL);
+        command.set(Command.KEY_INDEX, 2);
+        command.set(Command.KEY_DATA, "1");
+        verifyEncode(channel, command, text("JMAK#s;94;1#"));
+
+        command = command(Command.TYPE_OUTPUT_CONTROL);
+        command.set(Command.KEY_INDEX, 3);
+        command.set(Command.KEY_DATA, "0");
+        verifyEncode(channel, command, text("JMAK#s;167;0#"));
+
+        command = command(Command.TYPE_POSITION_PERIODIC);
+        command.set(Command.KEY_FREQUENCY, 30);
+        verifyEncode(channel, command, text("JMAK#s;2;30#"));
+
+        command = command(Command.TYPE_SET_ODOMETER);
+        command.set(Command.KEY_DATA, "1000");
+        verifyEncode(channel, command, text("JMAK#s;30;1000#"));
+
+        command = command(Command.TYPE_SET_CONNECTION);
+        command.set(Command.KEY_SERVER, "191.233.246.121");
+        command.set(Command.KEY_PORT, 5259);
+        verifyEncode(channel, command, text("JMAK#s;13;191.233.246.121#s;12;5259#"));
+
+        command = command(Command.TYPE_SET_CONNECTION);
+        command.set(Command.KEY_SERVER, "jmak.com.br");
+        command.set(Command.KEY_PORT, 5259);
+        verifyEncode(channel, command, text("JMAK#s;43;jmak.com.br#s;12;5259#"));
+
+        verifyEncode(channel, command(Command.TYPE_REBOOT_DEVICE), text("JMAK#REBOOT#"));
+
+        command = command(Command.TYPE_SET_SPEED_LIMIT);
+        command.set(Command.KEY_DATA, "100");
+        verifyEncode(channel, command, text("JMAK#e;16;1#s;17;100#"));
+
+        command = command(Command.TYPE_ALARM_BATTERY);
+        command.set(Command.KEY_ENABLE, false);
+        verifyEncode(channel, command, text("JMAK#e;57;0#"));
+
+        command = command(Command.TYPE_ALARM_REMOVE);
+        command.set(Command.KEY_ENABLE, true);
+        verifyEncode(channel, command, text("JMAK#e;55;1#"));
+
+        command = command(Command.TYPE_ALARM_GEOFENCE);
+        command.set(Command.KEY_DATA, "0");
+        verifyEncode(channel, command, text("JMAK#e;59;0#"));
+
+    }
+
+}
