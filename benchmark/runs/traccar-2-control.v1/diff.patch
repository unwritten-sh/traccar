+package org.traccar.protocol;
+
+import org.traccar.Protocol;
+import org.traccar.StringProtocolEncoder;
+import org.traccar.model.Command;
+
+import java.util.regex.Pattern;
+
+public class JmakProtocolEncoder extends StringProtocolEncoder {
+
+    private static final int PARAM_REPORT_INTERVAL = 2;
+    private static final int PARAM_SERVER_PORT = 12;
+    private static final int PARAM_SERVER_IP = 13;
+    private static final int PARAM_OVERSPEED_EVENT = 16;
+    private static final int PARAM_OVERSPEED_LIMIT = 17;
+    private static final int PARAM_ODOMETER = 30;
+    private static final int PARAM_OUTPUT_1 = 34;
+    private static final int PARAM_SERVER_DOMAIN = 43;
+    private static final int PARAM_POWER_CUT_EVENT = 55;
+    private static final int PARAM_LOW_BATTERY_EVENT = 57;
+    private static final int PARAM_MOVEMENT_EVENT = 59;
+    private static final int PARAM_REBOOT = 93;
+    private static final int PARAM_OUTPUT_2 = 94;
+    private static final int PARAM_OUTPUT_3 = 167;
+
+    private static final Pattern IP_ADDRESS = Pattern.compile(
+            "^((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)$");
+
+    private record Parameter(boolean event, int id, String value) {
+        static Parameter set(int id, Object value) {
+            return new Parameter(false, id, String.valueOf(value));
+        }
+
+        static Parameter event(int id, Object value) {
+            return new Parameter(true, id, String.valueOf(value));
+        }
+    }
+
+    private final boolean textChannel;
+
+    public JmakProtocolEncoder(Protocol protocol, boolean textChannel) {
+        super(protocol);
+        this.textChannel = textChannel;
+    }
+
+    private String encode(Parameter... parameters) {
+        StringBuilder result = new StringBuilder(textChannel ? "JMAK#" : "$");
+        for (int i = 0; i < parameters.length; i++) {
+            Parameter parameter = parameters[i];
+            if (textChannel) {
+                result.append(parameter.event() ? 'e' : 's').append(';');
+                result.append(parameter.id()).append(';').append(parameter.value()).append('#');
+            } else {
+                if (i > 0) {
+                    result.append('|');
+                }
+                result.append(parameter.id()).append(';').append(parameter.value()).append(';');
+            }
+        }
+        if (!textChannel) {
+            result.append('#');
+        }
+        return result.toString();
+    }
+
+    private static int outputParameter(int index) {
+        return switch (index) {
+            case 2 -> PARAM_OUTPUT_2;
+            case 3 -> PARAM_OUTPUT_3;
+            default -> PARAM_OUTPUT_1;
+        };
+    }
+
+    private static int flag(Command command) {
+        return command.getBoolean(Command.KEY_ENABLE) ? 1 : 0;
+    }
+
+    @Override
+    protected Object encodeCommand(Command command) {
+        return switch (command.getType()) {
+            case Command.TYPE_CUSTOM -> command.getString(Command.KEY_DATA);
+            case Command.TYPE_ENGINE_STOP -> encode(Parameter.set(PARAM_OUTPUT_1, 1));
+            case Command.TYPE_ENGINE_RESUME -> encode(Parameter.set(PARAM_OUTPUT_1, 0));
+            case Command.TYPE_OUTPUT_CONTROL -> encode(Parameter.set(
+                    outputParameter(command.getInteger(Command.KEY_INDEX)), command.getString(Command.KEY_DATA)));
+            case Command.TYPE_POSITION_PERIODIC -> encode(
+                    Parameter.set(PARAM_REPORT_INTERVAL, command.getString(Command.KEY_FREQUENCY)));
+            case Command.TYPE_SET_ODOMETER -> encode(
+                    Parameter.set(PARAM_ODOMETER, command.getString(Command.KEY_DATA)));
+            case Command.TYPE_SET_CONNECTION -> {
+                String server = command.getString(Command.KEY_SERVER);
+                int serverParameter = IP_ADDRESS.matcher(server).matches() ? PARAM_SERVER_IP : PARAM_SERVER_DOMAIN;
+                yield encode(
+                        Parameter.set(serverParameter, server),
+                        Parameter.set(PARAM_SERVER_PORT, command.getString(Command.KEY_PORT)));
+            }
+            case Command.TYPE_REBOOT_DEVICE -> textChannel ? "JMAK#REBOOT#" : encode(Parameter.set(PARAM_REBOOT, 1));
+            case Command.TYPE_SET_SPEED_LIMIT -> encode(
+                    Parameter.event(PARAM_OVERSPEED_EVENT, 1),
+                    Parameter.set(PARAM_OVERSPEED_LIMIT, command.getString(Command.KEY_DATA)));
+            case Command.TYPE_ALARM_BATTERY -> encode(Parameter.event(PARAM_LOW_BATTERY_EVENT, flag(command)));
+            case Command.TYPE_ALARM_REMOVE -> encode(Parameter.event(PARAM_POWER_CUT_EVENT, flag(command)));
+            case Command.TYPE_ALARM_GEOFENCE -> encode(
+                    Parameter.event(PARAM_MOVEMENT_EVENT, command.getString(Command.KEY_DATA)));
+            default -> null;
+        };
+    }
+
+}
diff --git a/src/test/java/org/traccar/protocol/JmakProtocolEncoderTest.java b/src/test/java/org/traccar/protocol/JmakProtocolEncoderTest.java
