{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CEme4riJcLhHX6zrADb2S3","type":"tool_result","content":"The file /Users/victor/Repos/unwritten/uw-harness-cases/traccar/bench/trees/traccar-2-control/src/main/java/org/traccar/protocol/JmakProtocolEncoder.java has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"f4b30671-7c98-4180-8d52-5b93d55abfa3","uuid":"b5a6e775-3b77-4f1f-b1b4-ad96f8b8a324","timestamp":"2026-11-01T21:32:28.407Z","tool_use_result":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/traccar/bench/trees/traccar-2-control/src/main/java/org/traccar/protocol/JmakProtocolEncoder.java","oldString":"        }\n        static Parameter event(","newString":"        }\n\n        static Parameter event(","originalFile":"/*\n * Copyright 2025 Anton Tananaev (anton@traccar.org)\n *\n * Licensed under the Apache License, Version 2.0 (the \"License\");\n * you may not use this file except in compliance with the License.\n * You may obtain a copy of the License at\n *\n *     http://www.apache.org/licenses/LICENSE-2.0\n *\n * Unless required by applicable law or agreed to in writing, software\n * distributed under the License is distributed on an \"AS IS\" BASIS,\n * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n * See the License for the specific language governing permissions and\n * limitations under the License.\n */\npackage org.traccar.protocol;\n\nimport org.traccar.Protocol;\nimport org.traccar.StringProtocolEncoder;\nimport org.traccar.model.Command;\n\nimport java.util.regex.Pattern;\n\npublic class JmakProtocolEncoder extends StringProtocolEncoder {\n\n    private static final int PARAM_REPORT_INTERVAL = 2;\n    private static final int PARAM_SERVER_PORT = 12;\n    private static final int PARAM_SERVER_IP = 13;\n    private static final int PARAM_OVERSPEED_EVENT = 16;\n    private static final int PARAM_OVERSPEED_LIMIT = 17;\n    private static final int PARAM_ODOMETER = 30;\n    private static final int PARAM_OUTPUT_1 = 34;\n    private static final int PARAM_SERVER_DOMAIN = 43;\n    private static final int PARAM_POWER_CUT_EVENT = 55;\n    private static final int PARAM_LOW_BATTERY_EVENT = 57;\n    private static final int PARAM_MOVEMENT_EVENT = 59;\n    private static final int PARAM_REBOOT = 93;\n    private static final int PARAM_OUTPUT_2 = 94;\n    private static final int PARAM_OUTPUT_3 = 167;\n\n    private static final Pattern IP_ADDRESS = Pattern.compile(\n            \"^((25[0-5]|2[0-4]\\\\d|1\\\\d\\\\d|[1-9]?\\\\d)\\\\.){3}(25[0-5]|2[0-4]\\\\d|1\\\\d\\\\d|[1-9]?\\\\d)$\");\n\n    private record Parameter(boolean event, int id, String value) {\n        static Parameter set(int id, Object value) {\n            return new Parameter(false, id, String.valueOf(value));\n        }\n        static Parameter event(int id, Object value) {\n            return new Parameter(true, id, String.valueOf(value));\n        }\n    }\n\n    private final boolean textChannel;\n\n    public JmakProtocolEncoder(Protocol protocol, boolean textChannel) {\n        super(protocol);\n        this.textChannel = textChannel;\n    }\n\n    private String encode(Parameter... parameters) {\n        StringBuilder result = new StringBuilder(textChannel ? \"JMAK#\" : \"$\");\n        for (int i = 0; i < parameters.length; i++) {\n            Parameter parameter = parameters[i];\n            if (textChannel) {\n                result.append(parameter.event() ? 'e' : 's').append(';');\n                result.append(parameter.id()).append(';').append(parameter.value()).append('#');\n            } else {\n                if (i > 0) {\n                    result.append('|');\n                }\n                result.append(parameter.id()).append(';').append(parameter.value()).append(';');\n            }\n        }\n        if (!textChannel) {\n            result.append('#');\n        }\n        return result.toString();\n    }\n\n    private static int outputParameter(int index) {\n        return switch (index) {\n            case 2 -> PARAM_OUTPUT_2;\n            case 3 -> PARAM_OUTPUT_3;\n            default -> PARAM_OUTPUT_1;\n        };\n    }\n\n    private static int flag(Command command) {\n        return command.getBoolean(Command.KEY_ENABLE) ? 1 : 0;\n    }\n\n    @Override\n    protected Object encodeCommand(Command command) {\n        return switch (command.getType()) {\n            case Command.TYPE_CUSTOM -> command.getString(Command.KEY_DATA);\n            case Command.TYPE_ENGINE_STOP -> encode(Parameter.set(PARAM_OUTPUT_1, 1));\n            case Command.TYPE_ENGINE_RESUME -> encode(Parameter.set(PARAM_OUTPUT_1, 0));\n            case Command.TYPE_OUTPUT_CONTROL -> encode(Parameter.set(\n                    outputParameter(command.getInteger(Command.KEY_INDEX)), command.getString(Command.KEY_DATA)));\n            case Command.TYPE_POSITION_PERIODIC -> encode(\n                    Parameter.set(PARAM_REPORT_INTERVAL, command.getString(Command.KEY_FREQUENCY)));\n            case Command.TYPE_SET_ODOMETER -> encode(\n                    Parameter.set(PARAM_ODOMETER, command.getString(Command.KEY_DATA)));\n            case Command.TYPE_SET_CONNECTION -> {\n                String server = command.getString(Command.KEY_SERVER);\n                int serverParameter = IP_ADDRESS.matcher(server).matches() ? PARAM_SERVER_IP : PARAM_SERVER_DOMAIN;\n                yield encode(\n                        Parameter.set(serverParameter, server),\n                        Parameter.set(PARAM_SERVER_PORT, command.getString(Command.KEY_PORT)));\n            }\n            case Command.TYPE_REBOOT_DEVICE -> textChannel ? \"JMAK#REBOOT#\" : encode(Parameter.set(PARAM_REBOOT, 1));\n            case Command.TYPE_SET_SPEED_LIMIT -> encode(\n                    Parameter.event(PARAM_OVERSPEED_EVENT, 1),\n                    Parameter.set(PARAM_OVERSPEED_LIMIT, command.getString(Command.KEY_DATA)));\n            case Command.TYPE_ALARM_BATTERY -> encode(Parameter.event(PARAM_LOW_BATTERY_EVENT, flag(command)));\n            case Command.TYPE_ALARM_REMOVE -> encode(Parameter.event(PARAM_POWER_CUT_EVENT, flag(command)));\n            case Command.TYPE_ALARM_GEOFENCE -> encode(\n                    Parameter.event(PARAM_MOVEMENT_EVENT, command.getString(Command.KEY_DATA)));\n            default -> null;\n        };\n    }\n\n}\n","structuredPatch":[{"oldStart":45,"oldLines":6,"newStart":45,"newLines":7,"lines":["         static Parameter set(int id, Object value) {","             return new Parameter(false, id, String.valueOf(value));","         }","+","         static Parameter event(int id, Object value) {","             return new Parameter(true, id, String.valueOf(value));","         }"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01CEme4riJcLhHX6zrADb2S3","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
