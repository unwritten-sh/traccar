ger.getObject(any(), anyLong())).thenReturn(mock(Device.class));\n        passingHandler = new FilterHandler(cacheManager, null);\n    }\n\n    @BeforeEach\n    public void filteringHandler() {\n        var config = mockConfig(Map.of(\n                Keys.FILTER_INVALID.getKey(), \"true\",\n                Keys.FILTER_ZERO.getKey(), \"true\",\n                Keys.FILTER_DUPLICATE.getKey(), \"true\",\n                Keys.FILTER_FUTURE.getKey(), String.valueOf(5 * 60L),\n                Keys.FILTER_APPROXIMATE.getKey(), \"true\",\n                Keys.FILTER_STATIC.getKey(), \"true\",\n                Keys.FILTER_DISTANCE.getKey(), \"10\",\n                Keys.FILTER_MAX_SPEED.getKey(), \"500\",\n                Keys.FILTER_SKIP_LIMIT.getKey(), \"10\",\n                Keys.FILTER_SKIP_ATTRIBUTES.getKey(), \"alarm,result\"));\n        var cacheManager = mock(CacheManager.class);\n        when(cacheManager.getConfig()).thenReturn(config);\n        when(cacheManager.getObject(any(), anyLong())).thenReturn(mock(Device.class));\n        filteringHandler = new FilterHandler(cacheManager, null);\n    }\n\n    private Position createPosition(long deviceId, Date time, boolean valid, double speed) {\n        Position position = new Position();\n        position.setDeviceId(deviceId);\n        position.setTime(time);\n        position.setValid(valid);\n        position.setLatitude(10);\n        position.setLongitude(10);\n        position.setAltitude(10);\n        position.setSpeed(speed);\n        position.setCourse(10);\n        return position;\n    }\n\n    private Position createPosition(Date time, boolean valid, double speed) {\n        return createPosition(0, time, valid, speed);\n    }\n\n    @Test\n    public void testFilter() {\n\n        Position position = createPosition(new Date(), true, 10);\n\n        assertFalse(filteringHandler.filter(position));\n        assertFalse(passingHandler.filter(position));\n\n        position = createPosition(new Date(Long.MAX_VALUE), true, 10);\n\n        assertTrue(filteringHandler.filter(position));\n        assertFalse(passingHandler.filter(position));\n\n        position = createPosition(new Date(), false, 10);\n\n        assertTrue(filteringHandler.filter(position));\n        assertFalse(passingHandler.filter(position));\n\n    }\n\n    @Test\n    public void testSkipAttributes() {\n\n        Position position = createPosition(new Date(), true, 0);\n        position.addAlarm(Position.ALARM_GENERAL);\n\n        assertFalse(filteringHandler.filter(position));\n\n    }\n\n    @Test\n    public void testDefaultFuture() {\n\n        var cacheManager = mock(CacheManager.class);\n        when(cacheManager.getConfig()).thenReturn(mockConfig(Map.of()));\n        when(cacheManager.getObject(any(), anyLong())).thenReturn(mock(Device.class));\n        var handler = new FilterHandler(cacheManager, null);\n\n        assertTrue(handler.filter(createPosition(new Date(System.currentTimeMillis() + 2 * 86400000L), true, 10)));\n        assertFalse(handler.filter(createPosition(new Date(), true, 10)));\n\n    }\n\n    @Test\n    public void testDeviceAndGroupSettings() {\n\n        var config = mockConfig(Map.of(\n                Keys.FILTER_INVALID.getKey(), \"true\",\n                Keys.FILTER_FUTURE.getKey(), \"300\"));\n\n        Device defaultDevice = new Device();\n        defaultDevice.setId(1);\n\n        Device deviceOverride = new Device();\n        deviceOverride.setId(2);\n        deviceOverride.set(Keys.FILTER_INVALID.getKey(), false);\n        deviceOverride.set(Keys.FILTER_FUTURE.getKey(), 0L);\n\n        Group group = new Group();\n        group.setId(10);\n        group.set(Keys.FILTER_STATIC.getKey(), true);\n        group.set(Keys.FILTER_INVALID.getKey(), \"false\");\n\n        Device groupDevice = new Device();\n        groupDevice.setId(3);\n        groupDevice.setGroupId(10);\n\n        Device groupDeviceOverride = new Device();\n        groupDeviceOverride.setId(4);\n        groupDeviceOverride.setGroupId(10);\n        groupDeviceOverride.set(Keys.FILTER_STATIC.getKey(), false);\n\n        var cacheManager = mock(CacheManager.class);\n        when(cacheManager.getConfig()).thenReturn(config);\n        when(cacheManager.getObject(eq(Device.class), eq(1L))).thenReturn(defaultDevice);\n        when(cacheManager.getObject(eq(Device.class), eq(2L))).thenReturn(deviceOverride);\n        when(cacheManager.getObject(eq(Device.class), eq(3L))).thenReturn(groupDevice);\n        when(cacheManager.getObject(eq(Device.class), eq(4L))).thenReturn(groupDeviceOverride);\n        when(cacheManager.getObject(eq(Group.class), eq(10L))).thenReturn(group);\n        var handler = new FilterHandler(cacheManager, null);\n\n        Date future = new Date(System.currentTimeMillis() + 3600000L);\n\n        // server configuration applies to device without attributes\n        assertTrue(handler.filter(createPosition(1, new Date(), false, 10)));\n        assertTrue(handler.filter(createPosition(1, future, true, 10)));\n        assertFalse(handler.filter(createPosition(1, new Date(), true, 0)));\n\n        // device attributes disable filters for that device only\n        assertFalse(handler.filter(createPosition(2, new Date(), false, 10)));\n        assertFalse(handler.filter(createPosition(2, future, true, 10)));\n\n        // group attributes apply to devices in the group\n        assertFalse(handler.filter(createPosition(3, new Date(), false, 10)));\n        assertTrue(handler.filter(createPosition(3, new Date(), true, 0)));\n        assertTrue(handler.filter(createPosition(3, future, true, 10)));\n\n        // device attribute has priority over group attribute\n        assertFalse(handler.filter(createPosition(4, new Date(), true, 0)));\n\n    }\n\n}\n"}}}
