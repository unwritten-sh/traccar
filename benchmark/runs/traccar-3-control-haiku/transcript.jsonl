ter(createPosition(DEVICE_1, new Date(), false, 10)));\n\n        var zero = createPosition(DEVICE_1, new Date(), true, 10);\n        zero.setLatitude(0);\n        zero.setLongitude(0);\n        assertFalse(handler.filter(zero));\n\n    }\n\n    @Test\n    public void testServerConfigAppliesToAllDevices() {\n\n        config.setString(Keys.FILTER_INVALID, \"true\");\n\n        assertTrue(handler.filter(createPosition(DEVICE_1, new Date(), false, 10)));\n        assertTrue(handler.filter(createPosition(DEVICE_2, new Date(), false, 10)));\n\n    }\n\n    @Test\n    public void testDeviceAttributeOverridesServerConfig() {\n\n        config.setString(Keys.FILTER_INVALID, \"true\");\n        devices.get(DEVICE_1).set(Keys.FILTER_INVALID.getKey(), false);\n\n        assertFalse(handler.filter(createPosition(DEVICE_1, new Date(), false, 10)));\n        assertTrue(handler.filter(createPosition(DEVICE_2, new Date(), false, 10)));\n\n    }\n\n    @Test\n    public void testGroupAttributeAppliesToMembers() {\n\n        config.setString(Keys.FILTER_ZERO, \"true\");\n        var group = new Group();\n        group.setId(GROUP);\n        group.set(Keys.FILTER_ZERO.getKey(), false);\n        groups.put(GROUP, group);\n        devices.get(DEVICE_1).setGroupId(GROUP);\n\n        var zero1 = createPosition(DEVICE_1, new Date(), true, 10);\n        zero1.setLatitude(0);\n        zero1.setLongitude(0);\n        assertFalse(handler.filter(zero1));\n\n        var zero2 = createPosition(DEVICE_2, new Date(), true, 10);\n        zero2.setLatitude(0);\n        zero2.setLongitude(0);\n        assertTrue(handler.filter(zero2));\n\n    }\n\n    @Test\n    public void testZeroValueDisablesFilter() {\n\n        devices.get(DEVICE_1).set(Keys.FILTER_FUTURE.getKey(), 0);\n\n        var future = createPosition(DEVICE_1, new Date(Long.MAX_VALUE), true, 10);\n        assertFalse(handler.filter(future));\n        assertTrue(handler.filter(createPosition(DEVICE_2, new Date(Long.MAX_VALUE), true, 10)));\n\n    }\n\n    @Test\n    public void testMinPeriodPerDevice() {\n\n        devices.get(DEVICE_1).set(Keys.FILTER_MIN_PERIOD.getKey(), 60);\n        long now = System.currentTimeMillis();\n        lastPositions.put(DEVICE_1, createPosition(DEVICE_1, new Date(now), true, 10));\n        lastPositions.put(DEVICE_2, createPosition(DEVICE_2, new Date(now), true, 10));\n\n        assertTrue(handler.filter(createPosition(DEVICE_1, new Date(now + 10_000), true, 10)));\n        assertFalse(handler.filter(createPosition(DEVICE_2, new Date(now + 10_000), true, 10)));\n\n    }\n\n    @Test\n    public void testAccuracyPerDevice() {\n\n        devices.get(DEVICE_1).set(Keys.FILTER_ACCURACY.getKey(), 10);\n\n        var position1 = createPosition(DEVICE_1, new Date(), true, 10);\n        position1.setAccuracy(50);\n        var position2 = createPosition(DEVICE_2, new Date(), true, 10);\n        position2.setAccuracy(50);\n\n        assertTrue(handler.filter(position1));\n        assertFalse(handler.filter(position2));\n\n    }\n\n    @Test\n    public void testDailyLimitPerDevice() {\n\n        devices.get(DEVICE_1).set(Keys.FILTER_DAILY_LIMIT.getKey(), 3);\n        devices.get(DEVICE_1).set(Keys.FILTER_DAILY_LIMIT_INTERVAL.getKey(), 60);\n        when(statisticsManager.messageStoredCount(DEVICE_1)).thenReturn(5);\n        when(statisticsManager.messageStoredCount(DEVICE_2)).thenReturn(5);\n        long now = System.currentTimeMillis();\n        lastPositions.put(DEVICE_1, createPosition(DEVICE_1, new Date(now), true, 10));\n        lastPositions.put(DEVICE_2, createPosition(DEVICE_2, new Date(now), true, 10));\n\n        assertTrue(handler.filter(createPosition(DEVICE_1, new Date(now + 10_000), true, 10)));\n        assertFalse(handler.filter(createPosition(DEVICE_2, new Date(now + 10_000), true, 10)));\n\n    }\n\n    @Test\n    public void testSkipAttributes() {\n\n        config.setString(Keys.FILTER_STATIC, \"true\");\n        config.setString(Keys.FILTER_SKIP_ATTRIBUTES, \"alarm,result\");\n\n        Position position = createPosition(DEVICE_1, new Date(), true, 0);\n        position.addAlarm(Position.ALARM_GENERAL);\n\n        assertFalse(handler.filter(position));\n\n    }\n\n}\n","structuredPatch":[{"oldStart":5,"oldLines":57,"newStart":5,"newLines":65,"lines":[" import org.traccar.BaseTest;"," import org.traccar.config.Config;"," import org.traccar.config.Keys;","+import org.traccar.database.StatisticsManager;"," import org.traccar.model.Device;","+import org.traccar.model.Group;"," import org.traccar.model.Position;"," import org.traccar.session.cache.CacheManager;"," "," import java.util.Date;","+import java.util.HashMap;","+import java.util.Map;"," "," import static org.junit.jupiter.api.Assertions.assertFalse;"," import static org.junit.jupiter.api.Assertions.assertTrue;","-import static org.mockito.ArgumentMatchers.any;"," import static org.mockito.ArgumentMatchers.anyLong;","+import static org.mockito.ArgumentMatchers.eq;"," import static org.mockito.Mockito.mock;"," import static org.mockito.Mockito.when;"," "," public class FilterHandlerTest extends BaseTest {"," ","-    private FilterHandler passingHandler;","-    private FilterHandler filteringHandler;","+    private static final long DEVICE_1 = 1;","+    private static final long DEVICE_2 = 2;","+    private static final long GROUP = 7;"," ","+    private Config config;","+    private StatisticsManager statisticsManager;","+    private FilterHandler handler;","+    private final Map<Long, Device> devices = new HashMap<>();","+    private final Map<Long, Group> groups = new HashMap<>();","+    private final Map<Long, Position> lastPositions = new HashMap<>();","+","     @BeforeEach","-    public void passingHandler() {","-        var config = mock(Config.class);","-        when(config.getBoolean(Keys.FILTER_ENABLE)).thenReturn(true);","+    public void setUp() {","+        config = new Config();","         var cacheManager = mock(CacheManager.class);","         when(ca