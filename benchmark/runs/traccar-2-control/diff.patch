+package org.traccar.protocol;
+
+import org.traccar.Protocol;
+import org.traccar.StringProtocolEncoder;
+import org.traccar.model.Command;
+
+import java.util.regex.Pattern;
+
+public class JmakProtocolEncoder extends StringProtocolEncoder {
+
+    private static final Pattern IP_ADDRESS = Pattern.compile(
+            "^((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)$");
+
+    private static final int PARAM_REPORT_INTERVAL = 2;
+    private static final int PARAM_SERVER_PORT = 12;
+    private static final int PARAM_SERVER_IP = 13;
+    private static final int PARAM_OVERSPEED_EVENT = 16;
+    private static final int PARAM_OVERSPEED_LIMIT = 17;
+    private static final int PARAM_ODOMETER = 30;
+    private static final int PARAM_OUTPUT_1 = 34;
+    private static final int PARAM_SERVER_DOMAIN = 43;
+    private static final int PARAM_POWER_CUT_EVENT = 55;
+    private static final int PARAM_LOW_BATTERY_EVENT = 57;
+    private static final int PARAM_MOVEMENT_EVENT = 59;
+    private static final int PARAM_REBOOT = 93;
+    private static final int PARAM_OUTPUT_2 = 94;
+    private static final int PARAM_OUTPUT_3 = 167;
+
+    private final boolean textChannel;
+
+    public JmakProtocolEncoder(Protocol protocol, boolean textChannel) {
+        super(protocol);
+        this.textChannel = textChannel;
+    }
+
+    private record Parameter(char action, int id, Object value) {
+    }
+
+    private static Parameter set(int id, Object value) {
+        return new Parameter('s', id, value);
+    }
+
+    private static Parameter event(int id, Object value) {
+        return new Parameter('e', id, value);
+    }
+
+    private String encodeParameters(Parameter... parameters) {
+        StringBuilder result = new StringBuilder();
+        if (textChannel) {
+            result.append("JMAK#");
+            for (Parameter parameter : parameters) {
+                result.append(parameter.action()).append(';')
+                        .append(parameter.id()).append(';')
+                        .append(parameter.value()).append('#');
+            }
+        } else {
+            result.append('$');
+            for (int i = 0; i < parameters.length; i++) {
+                if (i > 0) {
+                    result.append('|');
+                }
+                result.append(parameters[i].id()).append(';').append(parameters[i].value()).append(';');
+            }
+            result.append('#');
+        }
+        return result.toString();
+    }
+
+    private static int flag(Command command) {
+        return command.getBoolean(Command.KEY_ENABLE) ? 1 : 0;
+    }
+
+    @Override
+    protected Object encodeCommand(Command command) {
+
+        return switch (command.getType()) {
+            case Command.TYPE_CUSTOM -> command.getString(Command.KEY_DATA);
+            case Command.TYPE_ENGINE_STOP -> encodeParameters(set(PARAM_OUTPUT_1, 1));
+            case Command.TYPE_ENGINE_RESUME -> encodeParameters(set(PARAM_OUTPUT_1, 0));
+            case Command.TYPE_OUTPUT_CONTROL -> {
+                int id = switch (command.getInteger(Command.KEY_INDEX)) {
+                    case 1 -> PARAM_OUTPUT_1;
+                    case 2 -> PARAM_OUTPUT_2;
+                    case 3 -> PARAM_OUTPUT_3;
+                    default -> 0;
+                };
+                yield id > 0 ? encodeParameters(set(id, command.getString(Command.KEY_DATA))) : null;
+            }
+            case Command.TYPE_POSITION_PERIODIC ->
+                    encodeParameters(set(PARAM_REPORT_INTERVAL, command.getString(Command.KEY_FREQUENCY)));
+            case Command.TYPE_SET_ODOMETER ->
+                    encodeParameters(set(PARAM_ODOMETER, command.getString(Command.KEY_DATA)));
+            case Command.TYPE_SET_CONNECTION -> {
+                String server = command.getString(Command.KEY_SERVER);
+                int serverParam = server != null && IP_ADDRESS.matcher(server).matches()
+                        ? PARAM_SERVER_IP : PARAM_SERVER_DOMAIN;
+                yield encodeParameters(
+                        set(serverParam, server),
+                        set(PARAM_SERVER_PORT, command.getString(Command.KEY_PORT)));
+            }
+            case Command.TYPE_REBOOT_DEVICE -> textChannel ? "JMAK#REBOOT#" : encodeParameters(set(PARAM_REBOOT, 1));
+            case Command.TYPE_SET_SPEED_LIMIT -> encodeParameters(
+                    event(PARAM_OVERSPEED_EVENT, 1),
+                    set(PARAM_OVERSPEED_LIMIT, command.getString(Command.KEY_DATA)));
+            case Command.TYPE_ALARM_BATTERY -> encodeParameters(event(PARAM_LOW_BATTERY_EVENT, flag(command)));
+            case Command.TYPE_ALARM_REMOVE -> encodeParameters(event(PARAM_POWER_CUT_EVENT, flag(command)));
+            case Command.TYPE_ALARM_VIBRATION ->
+                    encodeParameters(event(PARAM_MOVEMENT_EVENT, command.getString(Command.KEY_DATA)));
+            default -> null;
+        };
+    }
+
+}
diff --git a/src/test/java/org/traccar/protocol/JmakProtocolEncoderTest.java b/src/test/java/org/traccar/protocol/JmakProtocolEncoderTest.java
