nd) {\n        return command.getBoolean(Command.KEY_ENABLE) ? 1 : 0;\n    }\n\n    @Override\n    protected Object encodeCommand(Channel channel, Command command) {\n\n        return switch (command.getType()) {\n            case Command.TYPE_CUSTOM -> command.getString(Command.KEY_DATA);\n            case Command.TYPE_ENGINE_STOP -> encodeParameters(set(PARAM_OUTPUT_1, 1));\n            case Command.TYPE_ENGINE_RESUME -> encodeParameters(set(PARAM_OUTPUT_1, 0));\n            case Command.TYPE_OUTPUT_CONTROL -> {\n                int id = switch (command.getInteger(Command.KEY_INDEX)) {\n                    case 1 -> PARAM_OUTPUT_1;\n                    case 2 -> PARAM_OUTPUT_2;\n                    case 3 -> PARAM_OUTPUT_3;\n                    default -> 0;\n                };\n                yield id > 0 ? encodeParameters(set(id, command.getString(Command.KEY_DATA))) : null;\n            }\n            case Command.TYPE_POSITION_PERIODIC ->\n                    encodeParameters(set(PARAM_REPORT_INTERVAL, command.getString(Command.KEY_FREQUENCY)));\n            case Command.TYPE_SET_ODOMETER ->\n                    encodeParameters(set(PARAM_ODOMETER, command.getString(Command.KEY_DATA)));\n            case Command.TYPE_SET_CONNECTION -> {\n                String server = command.getString(Command.KEY_SERVER);\n                int serverParam = server != null && IP_ADDRESS.matcher(server).matches()\n                        ? PARAM_SERVER_IP : PARAM_SERVER_DOMAIN;\n                yield encodeParameters(\n                        set(serverParam, server),\n                        set(PARAM_SERVER_PORT, command.getString(Command.KEY_PORT)));\n            }\n            case Command.TYPE_REBOOT_DEVICE -> textChannel ? \"JMAK#REBOOT#\" : encodeParameters(set(PARAM_REBOOT, 1));\n            case Command.TYPE_SET_SPEED_LIMIT -> encodeParameters(\n                    event(PARAM_OVERSPEED_EVENT, 1),\n                    set(PARAM_OVERSPEED_LIMIT, command.getString(Command.KEY_DATA)));\n            case Command.TYPE_ALARM_BATTERY -> encodeParameters(event(PARAM_LOW_BATTERY_EVENT, flag(command)));\n            case Command.TYPE_ALARM_REMOVE -> encodeParameters(event(PARAM_POWER_CUT_EVENT, flag(command)));\n            case Command.TYPE_ALARM_VIBRATION ->\n                    encodeParameters(event(PARAM_MOVEMENT_EVENT, command.getString(Command.KEY_DATA)));\n            default -> null;\n        };\n    }\n\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01GQgFmUgjksfQ4UPXCPAv5v","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
