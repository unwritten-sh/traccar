\t                        Unpooled.copiedBuffer(\"ACK\", StandardCharsets.US_ASCII), remoteAddress));\n49\t            }\n50\t            return null;\n51\t        }\n52\t\n53\t        if (!sentence.startsWith(\"~\") || !sentence.endsWith(\"$\")) {\n54\t            return null;\n55\t        }\n56\t\n57\t        String[] parts = sentence.substring(1, sentence.length() - 1).split(\"\\\\|\");\n58\t\n59\t        String[] values = parts[0].split(\";\");\n60\t        boolean serial = BitUtil.check(Long.parseLong(values[0], 16), 0);\n61\t        DeviceSession session = getDeviceSession(channel, remoteAddress, values[serial ? 2 : 1]);\n62\t        if (session == null) {\n63\t            return null;\n64\t        }\n65\t\n66\t        Position position = new Position(getProtocolName());\n67\t        position.setDeviceId(session.getDeviceId());\n68\t\n69\t        decodeEvent(position, values);\n70\t\n71\t        if (parts.length >= 2) {\n72\t            decodeCan(position, parts[1].split(\";\"));\n73\t        }\n74\t\n75\t        if (channel != null) {\n76\t            channel.writeAndFlush(new NetworkMessage(\n77\t                    Unpooled.copiedBuffer(\"ACK\", StandardCharsets.US_ASCII), remoteAddress));\n78\t        }\n79\t\n80\t        return position;\n81\t    }\n82\t\n83\t    private void decodeEvent(Position position, String[] values) {\n84\t        int index = 0;\n85\t        long mask = Long.parseLong(values[index++], 16);\n86\t\n87\t        if (BitUtil.check(mask, 0)) {\n88\t            index += 1; // serial number\n89\t        }\n90\t\n91\t        if (BitUtil.check(mask, 1)) {\n92\t            index += 1; // imei\n93\t        }\n94\t\n95\t        if (BitUtil.check(mask, 2)) {\n96\t            position.set(Position.KEY_INDEX, Long.parseLong(values[index++]));\n97\t        }\n98\t\n99\t        if (BitUtil.check(mask, 3)) {\n100\t            if (!values[index++].equals(\"NULL\")) {\n101\t                position.set(\"nickname\", values[index - 1]);\n102\t            }\n103\t        }\n104\t\n105\t        if (BitUtil.check(mask, 4)) {\n106\t            position.setTime(new Date(Long.parseLong(values[index++])));\n107\t        }\n108\t\n109\t        if (BitUtil.check(mask, 5)) {\n110\t            position.setLatitude(Double.parseDouble(values[index++]));\n111\t        }\n112\t\n113\t        if (BitUtil.check(mask, 6)) {\n114\t            position.setLongitude(Double.parseDouble(values[index++]));\n115\t        }\n116\t\n117\t        if (BitUtil.check(mask, 7)) {\n118\t            position.setAltitude(Double.parseDouble(values[index++]));\n119\t        }\n120\t\n121\t        if (BitUtil.check(mask, 8)) {\n122\t            index += 1;\n123\t        }\n124\t\n125\t        if (BitUtil.check(mask, 9)) {\n126\t            position.setSpeed(UnitsConverter.knotsFromKph(Double.parseDouble(values[index++])));\n127\t        }\n128\t\n129\t        if (BitUtil.check(mask, 10)) {\n130\t            position.set(Position.KEY_SATELLITES, Integer.parseInt(values[index++]));\n131\t        }\n132\t\n133\t        if (BitUtil.check(mask, 11)) {\n134\t            position.set(Position.KEY_RSSI, Integer.parseInt(values[index++]));\n135\t        }\n136\t\n137\t        if (BitUtil.check(mask, 12)) {\n138\t            position.set(Position.KEY_HDOP, Double.parseDouble(values[index++]));\n139\t        }\n140\t\n141\t        if (BitUtil.check(mask, 13)) {\n142\t            position.setCourse(Double.parseDouble(values[index++]));\n143\t        }\n144\t\n145\t        if (BitUtil.check(mask, 14)) {\n146\t            position.set(Position.KEY_IGNITION, Integer.parseInt(values[index++]) == 1);\n147\t        }\n148\t\n149\t        if (BitUtil.check(mask, 15)) {\n150\t            position.set(Position.KEY_ARCHIVE, Integer.parseInt(values[index++]) == 1);\n151\t        }\n152\t\n153\t        if (BitUtil.check(mask, 16)) {\n154\t            position.set(Position.KEY_HOURS, Double.parseDouble(values[index++]) * 3600000);\n155\t        }\n156\t\n157\t        if (BitUtil.check(mask, 17)) {\n158\t            position.set(Position.KEY_ODOMETER, Double.parseDouble(values[index++]) * 1000);\n159\t        }\n160\t\n161\t        int eventId;\n162\t        if (BitUtil.check(mask, 18)) {\n163\t            eventId = Integer.parseInt(values[index++]);\n164\t            position.set(Position.KEY_EVENT, eventId);\n165\t        } else {\n166\t            eventId = 0;\n167\t        }\n168\t\n169\t        int eventStatus;\n170\t        if (BitUtil.check(mask, 19)) {\n171\t            eventStatus = Integer.parseInt(values[index++]);\n172\t            position.set(\"eventStatus\", eventStatus);\n173\t            position.set(Position.KEY_ALARM, decodeAlarm(eventId, eventStatus));\n174\t        } else {\n175\t            eventStatus = 0;\n176\t        }\n177\t\n178\t        String eventName;\n179\t        if (BitUtil.check(mask, 20)) {\n180\t            eventName = values[index++];\n181\t            position.set(\"eventName\", eventName);\n182\t        } else {\n183\t            eventName = null;\n184\t        }\n185\t\n186\t        if (eventId == 126 && (eventStatus == 1 || eventStatus == 8) && eventName != null) {\n187\t            position.set(Position.KEY_DRIVER_UNIQUE_ID, eventName);\n188\t        }\n189\t\n190\t        if (BitUtil.check(mask, 21)) {\n191\t            position.set(Position.KEY_POWER, Integer.parseInt(values[index++]) / 1000.0);\n192\t        }\n193\t\n194\t        if (BitUtil.check(mask, 22)) {\n195\t            position.set(Position.KEY_BATTERY, Integer.parseInt(values[index++]) / 1000.0);\n196\t        }\n197\t\n198\t        if (BitUtil.check(mask, 23)) {\n199\t            position.set(Position.KEY_OPERATOR, values[index++]);\n200\t        }\n201\t\n202\t        if (BitUtil.check(mask, 24)) {\n203\t            index += 1; // cellular technology\n204\t        }\n205\t\n206\t        if (BitUtil.check(mask, 25)) {\n207\t            position.setDeviceTime(new Date(Long.parseLong(values[index++])));\n208\t        }\n209\t\n210\t        if (BitUtil.check(mask, 26)) {\n211\t            position.setValid(Integer.parseInt(values[index++]) >= 1);\n212\t        }\n213\t\n214\t        if (BitUtil.check(mask, 27)) {\n215\t            position.set(Position.KEY_STATUS, Integer.parseInt(values[index++]));\n216\t        }\n217\t\n218\t        if (BitUtil.check(mask, 28)) {\n219\t            String tag = values[index++];\n220\t            if (!tag.equals(\"0\")) {\n221\t                position.set(Position.KEY_DRIVER_UNIQUE_ID, tag);\n222\t            }\n223\t        }\n224\t\n225\t        if (BitUtil.check(mask, 29)) {\n226\t            index += 1; // transparent message length\n227\t        }\n228\t\n229\t        if (BitUtil.check(mask, 30)) {\n230\t            position.set(\"message\", values[index++]);\n231\t        }\n232\t\n233\t        if (BitUtil.check(mask, 31)) {\n234\t            index += 1;\n235\t        }\n236\t\n237\t        if (BitUtil.check(mask, 32)) {\n238\t            index += 1;\n239\t        }\n240\t\n241\t        if (BitUtil.check(mask, 33)) {\n242\t            index += 1;\n243\t        }\n244\t\n245\t        if (BitUtil.check(mask, 34)) {\n246\t            position.set(Position.PREFIX_ADC + 1, Double.parseDouble(values[index++]));\n247\t        }\n248\t\n249\t        if (BitUtil.check(mask, 35)) {\n250\t            position.set(Position.KEY_VERSION_FW, decodeVersion(\n251\t                    Unpooled.wrappedBuffer(DataConverter.parseHex(values[index++]))));\n252\t        }\n253\t\n254\t        if (BitUtil.check(mask, 36)) {\n255\t            position.set(\"model\", values[index++]);\n256\t        }\n257\t\n258\t        if (BitUtil.check(mask, 37)) {\n259\t            position.set(\"tripId\", Long.parseLong(values[index++]));\n260\t        }\n261\t    }\n262\t\n263\t    private void decodeCan(Position position, String[] values) {\n264\t        int index = 0;\n265\t        long mask = Long.parseLong(values[index++], 16);\n266\t\n267\t        if (BitUtil.check(mask, 0)) {\n268\t 