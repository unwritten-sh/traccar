93;\n    private static final int PARAM_OUTPUT_2 = 94;\n    private static final int PARAM_OUTPUT_3 = 167;\n\n    private static final Pattern IPV4_PATTERN = Pattern.compile(\"\\\\d{1,3}(\\\\.\\\\d{1,3}){3}\");\n\n    private static final String SMS_PREFIX = \"JMAK#\";\n    private static final String SMS_REBOOT = \"JMAK#REBOOT#\";\n\n    private static final char ACTION_SET = 's';\n    private static final char ACTION_EVENT = 'e';\n\n    private record Parameter(char action, int id, String value) {\n    }\n\n    private final boolean textChannel;\n\n    public JmakProtocolEncoder(Protocol protocol, boolean textChannel) {\n        super(protocol);\n        this.textChannel = textChannel;\n    }\n\n    @Override\n    protected Object encodeCommand(Command command) {\n\n        if (command.getType().equals(Command.TYPE_CUSTOM)) {\n            return command.getString(Command.KEY_DATA);\n        }\n\n        if (textChannel && command.getType().equals(Command.TYPE_REBOOT_DEVICE)) {\n            return SMS_REBOOT;\n        }\n\n        List<Parameter> parameters = createParameters(command);\n        if (parameters == null) {\n            return null;\n        }\n\n        if (textChannel) {\n            StringJoiner joiner = new StringJoiner(\"#\", SMS_PREFIX, \"#\");\n            for (Parameter parameter : parameters) {\n                joiner.add(parameter.action() + \";\" + parameter.id() + \";\" + parameter.value());\n            }\n            return joiner.toString();\n        } else {\n            StringJoiner joiner = new StringJoiner(\"|\", \"$\", \"#\");\n            for (Parameter parameter : parameters) {\n                joiner.add(parameter.id() + \";\" + parameter.value() + \";\");\n            }\n            return joiner.toString();\n        }\n    }\n\n    private List<Parameter> createParameters(Command command) {\n        return switch (command.getType()) {\n            case Command.TYPE_ENGINE_STOP -> List.of(\n                    new Parameter(ACTION_SET, PARAM_OUTPUT_1, \"1\"));\n            case Command.TYPE_ENGINE_RESUME -> List.of(\n                    new Parameter(ACTION_SET, PARAM_OUTPUT_1, \"0\"));\n            case Command.TYPE_OUTPUT_CONTROL -> {\n                Integer parameter = switch (command.getInteger(Command.KEY_INDEX)) {\n                    case 1 -> PARAM_OUTPUT_1;\n                    case 2 -> PARAM_OUTPUT_2;\n                    case 3 -> PARAM_OUTPUT_3;\n                    default -> null;\n                };\n                yield parameter != null\n                        ? List.of(new Parameter(ACTION_SET, parameter, command.getString(Command.KEY_DATA)))\n                        : null;\n            }\n            case Command.TYPE_POSITION_PERIODIC -> List.of(\n                    new Parameter(ACTION_SET, PARAM_REPORT_INTERVAL, String.valueOf(\n                            command.getInteger(Command.KEY_FREQUENCY))));\n            case Command.TYPE_SET_ODOMETER -> List.of(\n                    new Parameter(ACTION_SET, PARAM_ODOMETER, command.getString(Command.KEY_DATA)));\n            case Command.TYPE_SET_CONNECTION -> {\n                String server = command.getString(Command.KEY_SERVER);\n                int serverParameter = IPV4_PATTERN.matcher(server).matches() ? PARAM_SERVER_IP : PARAM_SERVER_DOMAIN;\n                yield List.of(\n                        new Parameter(ACTION_SET, serverParameter, server),\n                        new Parameter(ACTION_SET, PARAM_SERVER_PORT, String.valueOf(\n                                command.getInteger(Command.KEY_PORT))));\n            }\n            case Command.TYPE_REBOOT_DEVICE -> List.of(\n                    new Parameter(ACTION_SET, PARAM_REBOOT, \"1\"));\n            case Command.TYPE_SET_SPEED_LIMIT -> List.of(\n                    new Parameter(ACTION_EVENT, PARAM_OVERSPEED_EVENT, \"1\"),\n                    new Parameter(ACTION_SET, PARAM_OVERSPEED_LIMIT, command.getString(Command.KEY_DATA)));\n            case Command.TYPE_ALARM_BATTERY -> List.of(\n                    new Parameter(ACTION_EVENT, PARAM_LOW_BATTERY_EVENT, enableValue(command)));\n            case Command.TYPE_ALARM_REMOVE -> List.of(\n                    new Parameter(ACTION_EVENT, PARAM_POWER_CUT_EVENT, enableValue(command)));\n            case Command.TYPE_ALARM_MOVEMENT -> List.of(\n                    new Parameter(ACTION_EVENT, PARAM_MOVEMENT_EVENT, command.getString(Command.KEY_DATA)));\n            default -> null;\n        };\n    }\n\n    private static String enableValue(Command command) {\n        return command.getBoolean(Command.KEY_ENABLE) ? \"1\" : \"0\";\n    }\n\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9272,"cache_read_input_tokens":85602,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9272},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"bf8f1475-228d-4796-ae58-ad0f616495b9","uuid":"9e07a2ca-2279-437c-92ad-298bdd444a97","timestamp":"2026-11-02T06:46:30.949Z","request_id":"req_011Cgdekk7a16TAnajCDZxY6","wire_tool_inputs":{"toolu_01C1XiLyNNNsPoe36AEjhNvi":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/traccar/bench/trees/traccar-2-harness-haiku/src/main/java/org/traccar/protocol/JmakProtocolEncoder.java","content":"/*\n * Copyright 2025 - 2026 Anton Tananaev (anton@traccar.org)\n *\n * Licensed under the Apache License, Version 2.0 (the \"License\");\n * you may not use this file except in compliance with the License.\n * You may obtain a copy of the License at\n *\n *     http://www.apache.org/licenses/LICENSE-2.0\n *\n * Unless required by applicable law or agreed to in writing, software\n * distributed under the License is distributed on an \"AS IS\" BASIS,\n * WITHOUT WARR