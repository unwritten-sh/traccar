+package org.traccar.protocol;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+import org.traccar.NetworkMessage;
+import org.traccar.ProtocolTest;
+import org.traccar.handler.network.NetworkMessageHandler;
+import org.traccar.model.Command;
+
+import java.nio.charset.StandardCharsets;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+
+public class JmakProtocolEncoderTest extends ProtocolTest {
+
+    private Command command(String type, Object... attributes) {
+        Command command = new Command();
+        command.setDeviceId(2);
+        command.setType(type);
+        for (int i = 0; i < attributes.length; i += 2) {
+            String key = (String) attributes[i];
+            switch (attributes[i + 1]) {
+                case String value -> command.set(key, value);
+                case Integer value -> command.set(key, value);
+                case Boolean value -> command.set(key, value);
+                default -> throw new IllegalArgumentException("Unsupported attribute type");
+            }
+        }
+        return command;
+    }
+
+    private static ByteBuf ascii(String text) {
+        return Unpooled.copiedBuffer(text, StandardCharsets.US_ASCII);
+    }
+
+    @Test
+    public void testEncodeTcp() throws Exception {
+
+        var channel = channel(inject(new JmakProtocolEncoder(null, false)));
+
+        verifyEncode(channel, command(Command.TYPE_CUSTOM, Command.KEY_DATA, "$34;1;#"),
+                ascii("$34;1;#"));
+
+        verifyEncode(channel, command(Command.TYPE_ENGINE_STOP),
+                ascii("$34;1;#"));
+
+        verifyEncode(channel, command(Command.TYPE_ENGINE_RESUME),
+                ascii("$34;0;#"));
+
+        verifyEncode(channel, command(Command.TYPE_OUTPUT_CONTROL,
+                        Command.KEY_INDEX, 1, Command.KEY_DATA, "1"),
+                ascii("$34;1;#"));
+
+        verifyEncode(channel, command(Command.TYPE_OUTPUT_CONTROL,
+                        Command.KEY_INDEX, 2, Command.KEY_DATA, "0"),
+                ascii("$94;0;#"));
+
+        verifyEncode(channel, command(Command.TYPE_OUTPUT_CONTROL,
+                        Command.KEY_INDEX, 3, Command.KEY_DATA, "1"),
+                ascii("$167;1;#"));
+
+        verifyEncode(channel, command(Command.TYPE_OUTPUT_CONTROL,
+                        Command.KEY_INDEX, 4, Command.KEY_DATA, "1"),
+                (Object) null);
+
+        verifyEncode(channel, command(Command.TYPE_POSITION_PERIODIC,
+                        Command.KEY_FREQUENCY, 60),
+                ascii("$2;60;#"));
+
+        verifyEncode(channel, command(Command.TYPE_SET_ODOMETER,
+                        Command.KEY_DATA, "1500"),
+                ascii("$30;1500;#"));
+
+        verifyEncode(channel, command(Command.TYPE_SET_CONNECTION,
+                        Command.KEY_SERVER, "jmak.com.br", Command.KEY_PORT, 5259),
+                ascii("$43;jmak.com.br;|12;5259;#"));
+
+        verifyEncode(channel, command(Command.TYPE_SET_CONNECTION,
+                        Command.KEY_SERVER, "191.233.246.121", Command.KEY_PORT, 5259),
+                ascii("$13;191.233.246.121;|12;5259;#"));
+
+        verifyEncode(channel, command(Command.TYPE_REBOOT_DEVICE),
+                ascii("$93;1;#"));
+
+        verifyEncode(channel, command(Command.TYPE_SET_SPEED_LIMIT,
+                        Command.KEY_DATA, "80"),
+                ascii("$16;1;|17;80;#"));
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_BATTERY,
+                        Command.KEY_ENABLE, true),
+                ascii("$57;1;#"));
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_BATTERY,
+                        Command.KEY_ENABLE, false),
+                ascii("$57;0;#"));
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_REMOVE,
+                        Command.KEY_ENABLE, true),
+                ascii("$55;1;#"));
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_REMOVE,
+                        Command.KEY_ENABLE, false),
+                ascii("$55;0;#"));
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_MOVEMENT,
+                        Command.KEY_DATA, "1"),
+                ascii("$59;1;#"));
+    }
+
+    @Test
+    public void testEncodeSms() throws Exception {
+
+        var channel = channel(inject(new JmakProtocolEncoder(null, true)));
+
+        verifyEncode(channel, command(Command.TYPE_ENGINE_STOP),
+                "JMAK#s;34;1#");
+
+        verifyEncode(channel, command(Command.TYPE_ENGINE_RESUME),
+                "JMAK#s;34;0#");
+
+        verifyEncode(channel, command(Command.TYPE_OUTPUT_CONTROL,
+                        Command.KEY_INDEX, 2, Command.KEY_DATA, "1"),
+                "JMAK#s;94;1#");
+
+        verifyEncode(channel, command(Command.TYPE_POSITION_PERIODIC,
+                        Command.KEY_FREQUENCY, 120),
+                "JMAK#s;2;120#");
+
+        verifyEncode(channel, command(Command.TYPE_SET_ODOMETER,
+                        Command.KEY_DATA, "1500"),
+                "JMAK#s;30;1500#");
+
+        verifyEncode(channel, command(Command.TYPE_SET_CONNECTION,
+                        Command.KEY_SERVER, "191.233.246.121", Command.KEY_PORT, 5259),
+                "JMAK#s;13;191.233.246.121#s;12;5259#");
+
+        verifyEncode(channel, command(Command.TYPE_SET_CONNECTION,
+                        Command.KEY_SERVER, "jmak.com.br", Command.KEY_PORT, 5259),
+                "JMAK#s;43;jmak.com.br#s;12;5259#");
+
+        verifyEncode(channel, command(Command.TYPE_REBOOT_DEVICE),
+                "JMAK#REBOOT#");
+
+        verifyEncode(channel, command(Command.TYPE_SET_SPEED_LIMIT,
+                        Command.KEY_DATA, "80"),
+                "JMAK#e;16;1#s;17;80#");
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_BATTERY,
+                        Command.KEY_ENABLE, false),
+                "JMAK#e;57;0#");
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_REMOVE,
+                        Command.KEY_ENABLE, true),
+                "JMAK#e;55;1#");
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_MOVEMENT,
+                        Command.KEY_DATA, "0"),
+                "JMAK#e;59;0#");
+
+        verifyEncode(channel, command(Command.TYPE_CUSTOM, Command.KEY_DATA, "JMAK#s;2;60#"),
+                "JMAK#s;2;60#");
+    }
+
+    @Test
+    public void testEncodeTcpPipeline() throws Exception {
+
+        var channel = channel(
+                new NetworkMessageHandler(),
+                inject(new JmakProtocolEncoder(null, false)));
+
+        channel.writeOutbound(new NetworkMessage(command(Command.TYPE_SET_CONNECTION,
+                Command.KEY_SERVER, "jmak.com.br", Command.KEY_PORT, 5259), null));
+
+        ByteBuf output = assertInstanceOf(ByteBuf.class, channel.readOutbound());
+        assertEquals("$43;jmak.com.br;|12;5259;#", output.toString(StandardCharsets.US_ASCII));
+        output.release();
+    }
+
+}
