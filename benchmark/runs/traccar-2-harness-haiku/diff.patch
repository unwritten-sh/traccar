+package org.traccar.protocol;
+
+import io.netty.buffer.Unpooled;
+import io.netty.channel.Channel;
+import org.traccar.Protocol;
+import org.traccar.StringProtocolEncoder;
+import org.traccar.model.Command;
+
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.StringJoiner;
+import java.util.regex.Pattern;
+
+public class JmakProtocolEncoder extends StringProtocolEncoder {
+
+    private static final int PARAM_REPORT_INTERVAL = 2;
+    private static final int PARAM_SERVER_PORT = 12;
+    private static final int PARAM_SERVER_IP = 13;
+    private static final int PARAM_OVERSPEED_EVENT = 16;
+    private static final int PARAM_OVERSPEED_LIMIT = 17;
+    private static final int PARAM_ODOMETER = 30;
+    private static final int PARAM_OUTPUT_1 = 34;
+    private static final int PARAM_SERVER_DOMAIN = 43;
+    private static final int PARAM_POWER_CUT_EVENT = 55;
+    private static final int PARAM_LOW_BATTERY_EVENT = 57;
+    private static final int PARAM_MOVEMENT_EVENT = 59;
+    private static final int PARAM_REBOOT = 93;
+    private static final int PARAM_OUTPUT_2 = 94;
+    private static final int PARAM_OUTPUT_3 = 167;
+
+    private static final Pattern IPV4_PATTERN = Pattern.compile("\\d{1,3}(\\.\\d{1,3}){3}");
+
+    private static final String SMS_PREFIX = "JMAK#";
+    private static final String SMS_REBOOT = "JMAK#REBOOT#";
+
+    private static final char ACTION_SET = 's';
+    private static final char ACTION_EVENT = 'e';
+
+    private record Parameter(char action, int id, String value) {
+    }
+
+    private final boolean textChannel;
+
+    public JmakProtocolEncoder(Protocol protocol, boolean textChannel) {
+        super(protocol);
+        this.textChannel = textChannel;
+    }
+
+    @Override
+    protected Object encodeCommand(Channel channel, Command command) {
+        Object encoded = encodeCommand(command);
+        if (!textChannel && encoded instanceof String text) {
+            return Unpooled.copiedBuffer(text, StandardCharsets.US_ASCII);
+        }
+        return encoded;
+    }
+
+    @Override
+    protected Object encodeCommand(Command command) {
+
+        if (command.getType().equals(Command.TYPE_CUSTOM)) {
+            return command.getString(Command.KEY_DATA);
+        }
+
+        if (textChannel && command.getType().equals(Command.TYPE_REBOOT_DEVICE)) {
+            return SMS_REBOOT;
+        }
+
+        List<Parameter> parameters = createParameters(command);
+        if (parameters == null) {
+            return null;
+        }
+
+        if (textChannel) {
+            StringJoiner joiner = new StringJoiner("#", SMS_PREFIX, "#");
+            for (Parameter parameter : parameters) {
+                joiner.add(parameter.action() + ";" + parameter.id() + ";" + parameter.value());
+            }
+            return joiner.toString();
+        } else {
+            StringJoiner joiner = new StringJoiner("|", "$", "#");
+            for (Parameter parameter : parameters) {
+                joiner.add(parameter.id() + ";" + parameter.value() + ";");
+            }
+            return joiner.toString();
+        }
+    }
+
+    private List<Parameter> createParameters(Command command) {
+        return switch (command.getType()) {
+            case Command.TYPE_ENGINE_STOP -> List.of(
+                    new Parameter(ACTION_SET, PARAM_OUTPUT_1, "1"));
+            case Command.TYPE_ENGINE_RESUME -> List.of(
+                    new Parameter(ACTION_SET, PARAM_OUTPUT_1, "0"));
+            case Command.TYPE_OUTPUT_CONTROL -> {
+                Integer parameter = switch (command.getInteger(Command.KEY_INDEX)) {
+                    case 1 -> PARAM_OUTPUT_1;
+                    case 2 -> PARAM_OUTPUT_2;
+                    case 3 -> PARAM_OUTPUT_3;
+                    default -> null;
+                };
+                yield parameter != null
+                        ? List.of(new Parameter(ACTION_SET, parameter, command.getString(Command.KEY_DATA)))
+                        : null;
+            }
+            case Command.TYPE_POSITION_PERIODIC -> List.of(
+                    new Parameter(ACTION_SET, PARAM_REPORT_INTERVAL, String.valueOf(
+                            command.getInteger(Command.KEY_FREQUENCY))));
+            case Command.TYPE_SET_ODOMETER -> List.of(
+                    new Parameter(ACTION_SET, PARAM_ODOMETER, command.getString(Command.KEY_DATA)));
+            case Command.TYPE_SET_CONNECTION -> {
+                String server = command.getString(Command.KEY_SERVER);
+                int serverParameter = IPV4_PATTERN.matcher(server).matches() ? PARAM_SERVER_IP : PARAM_SERVER_DOMAIN;
+                yield List.of(
+                        new Parameter(ACTION_SET, serverParameter, server),
+                        new Parameter(ACTION_SET, PARAM_SERVER_PORT, String.valueOf(
+                                command.getInteger(Command.KEY_PORT))));
+            }
+            case Command.TYPE_REBOOT_DEVICE -> List.of(
+                    new Parameter(ACTION_SET, PARAM_REBOOT, "1"));
+            case Command.TYPE_SET_SPEED_LIMIT -> List.of(
+                    new Parameter(ACTION_EVENT, PARAM_OVERSPEED_EVENT, "1"),
+                    new Parameter(ACTION_SET, PARAM_OVERSPEED_LIMIT, command.getString(Command.KEY_DATA)));
+            case Command.TYPE_ALARM_BATTERY -> List.of(
+                    new Parameter(ACTION_EVENT, PARAM_LOW_BATTERY_EVENT, enableValue(command)));
+            case Command.TYPE_ALARM_REMOVE -> List.of(
+                    new Parameter(ACTION_EVENT, PARAM_POWER_CUT_EVENT, enableValue(command)));
+            case Command.TYPE_ALARM_MOVEMENT -> List.of(
+                    new Parameter(ACTION_EVENT, PARAM_MOVEMENT_EVENT, command.getString(Command.KEY_DATA)));
+            default -> null;
+        };
+    }
+
+    private static String enableValue(Command command) {
+        return command.getBoolean(Command.KEY_ENABLE) ? "1" : "0";
+    }
+
+}
