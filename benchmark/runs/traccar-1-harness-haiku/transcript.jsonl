\t                        Unpooled.copiedBuffer(\"ACK\", StandardCharsets.US_ASCII), remoteAddress));\n49\t            }\n50\t            return null;\n51\t        }\n52\t\n53\t        if (!sentence.startsWith(\"~\") || !sentence.endsWith(\"$\")) {\n54\t            return null;\n55\t        }\n56\t\n57\t        String[] parts = sentence.substring(1, sentence.length() - 1).split(\"\\\\|\");\n58\t\n59\t        String[] values = parts[0].split(\";\");\n60\t        boolean serial = BitUtil.check(Long.parseLong(values[0], 16), 0);\n61\t        DeviceSession session = getDeviceSession(channel, remoteAddress, values[serial ? 2 : 1]);\n62\t        if (session == null) {\n63\t            return null;\n64\t        }\n65\t\n66\t        Position position = new Position(getProtocolName());\n67\t        position.setDeviceId(session.getDeviceId());\n68\t\n69\t        decodeEvent(position, values);\n70\t\n71\t        if (parts.length >= 2) {\n72\t            decodeCan(position, parts[1].split(\";\"));\n73\t        }\n74\t\n75\t        if (channel != null) {\n76\t            channel.writeAndFlush(new NetworkMessage(\n77\t                    Unpooled.copiedBuffer(\"ACK\", StandardCharsets.US_ASCII), remoteAddress));\n78\t        }\n79\t\n80\t        return position;\n81\t    }\n82\t\n83\t    private void decodeEvent(Position position, String[] values) {\n84\t        int index = 0;\n85\t        long mask = Long.parseLong(values[index++], 16);\n86\t\n87\t        if (BitUtil.check(mask, 0)) {\n88\t            index += 1; // serial number\n89\t        }\n90\t\n91\t        if (BitUtil.check(mask, 1)) {\n92\t            index += 1; // imei\n93\t        }\n94\t\n95\t        if (BitUtil.check(mask, 2)) {\n96\t            position.set(Position.KEY_INDEX, Long.parseLong(values[index++]));\n97\t        }\n98\t\n99\t        if (BitUtil.check(mask, 3)) {\n100\t            if (!values[index++].equals(\"NULL\")) {\n101\t                position.set(\"nickname\", values[index - 1]);\n102\t          