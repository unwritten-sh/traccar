()).thenReturn(config);\n        when(cacheManager.getObject(eq(Device.class), eq(1L))).thenReturn(plainDevice);\n        when(cacheManager.getObject(eq(Device.class), eq(2L))).thenReturn(deviceEnabled);\n        when(cacheManager.getObject(eq(Device.class), eq(3L))).thenReturn(groupDevice);\n        when(cacheManager.getObject(eq(Device.class), eq(4L))).thenReturn(overrideDevice);\n        when(cacheManager.getObject(eq(Group.class), eq(10L))).thenReturn(group);\n        var handler = new FilterHandler(cacheManager, null);\n\n        Date future = new Date(Long.MAX_VALUE);\n\n        assertFalse(handler.filter(createPosition(1, new Date(), false, 10)));\n        assertFalse(handler.filter(createPosition(1, future, true, 10)));\n\n        assertTrue(handler.filter(createPosition(2, new Date(), false, 10)));\n        assertFalse(handler.filter(createPosition(2, future, true, 10)));\n\n        assertTrue(handler.filter(createPosition(3, new Date(), false, 10)));\n        assertTrue(handler.filter(createPosition(3, future, true, 10)));\n\n        assertFalse(handler.filter(createPosition(4, new Date(), false, 10)));\n        assertFalse(handler.filter(createPosition(4, future, true, 10)));\n    }\n\n}\nEOF\n./gradlew test --tests org.traccar.handler.FilterHandlerTest -q 2>&1 | tail -30","uuid":"300d5ccd-85eb-4f1d-a55e-5258529be440","session_id":"9c4e3109-c142-4d66-ade1-fafbb40c2e8f"}
