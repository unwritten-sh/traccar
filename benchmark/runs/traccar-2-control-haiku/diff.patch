+package org.traccar.protocol;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.ProtocolTest;
+import org.traccar.model.Command;
+
+public class JmakProtocolEncoderTest extends ProtocolTest {
+
+    private static Command command(String type, Object... attributes) {
+        Command command = new Command();
+        command.setDeviceId(1);
+        command.setType(type);
+        for (int i = 0; i < attributes.length; i += 2) {
+            String key = (String) attributes[i];
+            Object value = attributes[i + 1];
+            if (value instanceof Boolean booleanValue) {
+                command.set(key, booleanValue);
+            } else if (value instanceof Integer integerValue) {
+                command.set(key, integerValue);
+            } else {
+                command.set(key, (String) value);
+            }
+        }
+        return command;
+    }
+
+    @Test
+    public void testEncodeDataChannel() throws Exception {
+
+        var channel = channel(inject(new JmakProtocolEncoder(null, false)));
+
+        verifyEncode(channel, command(Command.TYPE_ENGINE_STOP), "$34;1;#");
+        verifyEncode(channel, command(Command.TYPE_ENGINE_RESUME), "$34;0;#");
+
+        verifyEncode(channel, command(Command.TYPE_OUTPUT_CONTROL, Command.KEY_INDEX, 1, Command.KEY_DATA, "1"), "$34;1;#");
+        verifyEncode(channel, command(Command.TYPE_OUTPUT_CONTROL, Command.KEY_INDEX, 2, Command.KEY_DATA, "0"), "$94;0;#");
+        verifyEncode(channel, command(Command.TYPE_OUTPUT_CONTROL, Command.KEY_INDEX, 3, Command.KEY_DATA, "1"), "$167;1;#");
+        verifyEncode(channel, command(Command.TYPE_POSITION_PERIODIC, Command.KEY_FREQUENCY, 60), "$2;60;#");
+
+        verifyEncode(channel, command(Command.TYPE_SET_ODOMETER, Command.KEY_DATA, "12345"), "$30;12345;#");
+
+        verifyEncode(channel, command(Command.TYPE_SET_CONNECTION, Command.KEY_SERVER, "jmak.com.br", Command.KEY_PORT, 5259),
+                "$43;jmak.com.br;|12;5259;#");
+        verifyEncode(channel, command(Command.TYPE_SET_CONNECTION, Command.KEY_SERVER, "191.233.246.121", Command.KEY_PORT, 5259),
+                "$13;191.233.246.121;|12;5259;#");
+
+        verifyEncode(channel, command(Command.TYPE_REBOOT_DEVICE), "$93;1;#");
+
+        verifyEncode(channel, command(Command.TYPE_SET_SPEED_LIMIT, Command.KEY_DATA, "80"), "$16;1;|17;80;#");
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_BATTERY, Command.KEY_ENABLE, true), "$57;1;#");
+        verifyEncode(channel, command(Command.TYPE_ALARM_BATTERY, Command.KEY_ENABLE, false), "$57;0;#");
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_REMOVE, Command.KEY_ENABLE, true), "$55;1;#");
+        verifyEncode(channel, command(Command.TYPE_ALARM_REMOVE, Command.KEY_ENABLE, false), "$55;0;#");
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_MOVEMENT, Command.KEY_DATA, "1"), "$59;1;#");
+    }
+
+    @Test
+    public void testEncodeTextChannel() throws Exception {
+
+        var channel = channel(inject(new JmakProtocolEncoder(null, true)));
+
+        verifyEncode(channel, command(Command.TYPE_ENGINE_STOP), "JMAK#s;34;1#");
+        verifyEncode(channel, command(Command.TYPE_ENGINE_RESUME), "JMAK#s;34;0#");
+
+        verifyEncode(channel, command(Command.TYPE_OUTPUT_CONTROL, Command.KEY_INDEX, 1, Command.KEY_DATA, "1"), "JMAK#s;34;1#");
+        verifyEncode(channel, command(Command.TYPE_OUTPUT_CONTROL, Command.KEY_INDEX, 2, Command.KEY_DATA, "0"), "JMAK#s;94;0#");
+        verifyEncode(channel, command(Command.TYPE_OUTPUT_CONTROL, Command.KEY_INDEX, 3, Command.KEY_DATA, "1"), "JMAK#s;167;1#");
+
+        verifyEncode(channel, command(Command.TYPE_POSITION_PERIODIC, Command.KEY_FREQUENCY, 60), "JMAK#s;2;60#");
+
+        verifyEncode(channel, command(Command.TYPE_SET_ODOMETER, Command.KEY_DATA, "12345"), "JMAK#s;30;12345#");
+
+        verifyEncode(channel, command(Command.TYPE_SET_CONNECTION, Command.KEY_SERVER, "191.233.246.121", Command.KEY_PORT, 5259),
+                "JMAK#s;13;191.233.246.121#s;12;5259#");
+        verifyEncode(channel, command(Command.TYPE_SET_CONNECTION, Command.KEY_SERVER, "jmak.com.br", Command.KEY_PORT, 5259),
+                "JMAK#s;43;jmak.com.br#s;12;5259#");
+
+        verifyEncode(channel, command(Command.TYPE_REBOOT_DEVICE), "JMAK#REBOOT#");
+
+        verifyEncode(channel, command(Command.TYPE_SET_SPEED_LIMIT, Command.KEY_DATA, "80"), "JMAK#e;16;1#s;17;80#");
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_BATTERY, Command.KEY_ENABLE, false), "JMAK#e;57;0#");
+        verifyEncode(channel, command(Command.TYPE_ALARM_BATTERY, Command.KEY_ENABLE, true), "JMAK#e;57;1#");
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_REMOVE, Command.KEY_ENABLE, false), "JMAK#e;55;0#");
+        verifyEncode(channel, command(Command.TYPE_ALARM_REMOVE, Command.KEY_ENABLE, true), "JMAK#e;55;1#");
+
+        verifyEncode(channel, command(Command.TYPE_ALARM_MOVEMENT, Command.KEY_DATA, "1"), "JMAK#e;59;1#");
+    }
+
+}
