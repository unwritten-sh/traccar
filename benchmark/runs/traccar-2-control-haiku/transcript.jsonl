d{1,3}(\\\\.\\\\d{1,3}){3}\");\n\n    private static final int PARAM_REPORT_INTERVAL = 2;\n    private static final int PARAM_SERVER_PORT = 12;\n    private static final int PARAM_SERVER_IP = 13;\n    private static final int PARAM_OVERSPEED_EVENT = 16;\n    private static final int PARAM_OVERSPEED_LIMIT = 17;\n    private static final int PARAM_ODOMETER = 30;\n    private static final int PARAM_OUTPUT_1 = 34;\n    private static final int PARAM_SERVER_DOMAIN = 43;\n    private static final int PARAM_POWER_CUT_EVENT = 55;\n    private static final int PARAM_LOW_BATTERY_EVENT = 57;\n    private static final int PARAM_MOVEMENT_EVENT = 59;\n    private static final int PARAM_REBOOT = 93;\n    private static final int PARAM_OUTPUT_2 = 94;\n    private static final int PARAM_OUTPUT_3 = 167;\n\n    private static final String ACTION_SET = \"s\";\n    private static final String ACTION_EVENT = \"e\";\n\n    private record Parameter(String action, int id, String value) {\n    }\n\n    private final boolean textChannel;\n\n    public JmakProtocolEncoder(Protocol protocol, boolean textChannel) {\n        super(protocol);\n        this.textChannel = textChannel;\n    }\n\n    private static Parameter set(int id, Object value) {\n        return new Parameter(ACTION_SET, id, String.valueOf(value));\n    }\n\n    private static Parameter event(int id, Object value) {\n        return new Parameter(ACTION_EVENT, id, String.valueOf(value));\n    }\n\n    private static Integer outputParameter(int index) {\n        return switch (index) {\n            case 1 -> PARAM_OUTPUT_1;\n            case 2 -> PARAM_OUTPUT_2;\n            case 3 -> PARAM_OUTPUT_3;\n            default -> null;\n        };\n    }\n\n    private static int enableValue(Command command) {\n        return command.getBoolean(Command.KEY_ENABLE) ? 1 : 0;\n    }\n\n    private String encodeParameters(Parameter... parameters) {\n        StringBuilder builder = new StringBuilder();\n        if (textChannel) {\n            builder.append(\"JMAK#\");\n            for (Parameter parameter : parameters) {\n                builder.append(parameter.action()).append(';')\n                        .append(parameter.id()).append(';')\n                        .append(parameter.value()).append('#');\n            }\n        } else {\n            builder.append('$');\n            for (int i = 0; i < parameters.length; i++) {\n                if (i > 0) {\n                    builder.append('|');\n                }\n                builder.append(parameters[i].id()).append(';')\n                        .append(parameters[i].value()).append(';');\n            }\n            builder.append('#');\n        }\n        return builder.toString();\n    }\n\n    private String encodeConnection(Command command) {\n        String server = command.getString(Command.KEY_SERVER);\n        Parameter address = IPV4_PATTERN.matcher(server).matches()\n                ? set(PARAM_SERVER_IP, server)\n                : set(PARAM_SERVER_DOMAIN, server);\n        return encodeParameters(address, set(PARAM_SERVER_PORT, command.getInteger(Command.KEY_PORT)));\n    }\n\n    @Override\n    protected Object encodeCommand(Command command) {\n\n        return switch (command.getType()) {\n            case Command.TYPE_ENGINE_STOP -> encodeParameters(set(PARAM_OUTPUT_1, 1));\n            case Command.TYPE_ENGINE_RESUME -> encodeParameters(set(PARAM_OUTPUT_1, 0));\n            case Command.TYPE_OUTPUT_CONTROL -> {\n                Integer parameter = outputParameter(command.getInteger(Command.KEY_INDEX));\n                yield parameter != null\n                        ? encodeParameters(set(parameter, command.getString(Command.KEY_DATA)))\n                        : null;\n            }\n            case Command.TYPE_POSITION_PERIODIC ->\n                    encodeParameters(set(PARAM_REPORT_INTERVAL, command.getInteger(Command.KEY_FREQUENCY)));\n            case Command.TYPE_SET_ODOMETER -> encodeParameters(set(PARAM_ODOMETER, command.getString(Command.KEY_DATA)));\n            case Command.TYPE_SET_CONNECTION -> encodeConnection(command);\n            case Command.TYPE_REBOOT_DEVICE -> textChannel ? \"JMAK#REBOOT#\" : encodeParameters(set(PARAM_REBOOT, 1));\n            case Command.TYPE_SET_SPEED_LIMIT -> encodeParameters(\n                    event(PARAM_OVERSPEED_EVENT, 1),\n                    set(PARAM_OVERSPEED_LIMIT, command.getString(Command.KEY_DATA)));\n            case Command.TYPE_ALARM_BATTERY -> encodeParameters(event(PARAM_LOW_BATTERY_EVENT, enableValue(command)));\n            case Command.TYPE_ALARM_REMOVE -> encodeParameters(event(PARAM_POWER_CUT_EVENT, enableValue(command)));\n            case Command.TYPE_ALARM_MOVEMENT ->\n                    encodeParameters(event(PARAM_MOVEMENT_EVENT, command.getString(Command.KEY_DATA)));\n            default -> null;\n        };\n    }\n\n}\n","structuredPatch":[{"oldStart":119,"oldLines":7,"newStart":119,"newLines":8,"lines":["             }","             case Command.TYPE_POSITION_PERIODIC ->","                     encodeParameters(set(PARAM_REPORT_INTERVAL, command.getInteger(Command.KEY_FREQUENCY)));","-            case Command.TYPE_SET_ODOMETER -> encodeParameters(set(PARAM_ODOMETER, command.getString(Command.KEY_DATA)));","+            case Command.TYPE_SET_ODOMETER ->","+                    encodeParameters(set(PARAM_ODOMETER, command.getString(Command.KEY_DATA)));","             case Command.TYPE_SET_CONNECTION -> encodeConnection(command);","             case Command.TYPE_REBOOT_DEVICE -> textChannel ? \"JMAK#REBOOT#\" : encodeParameters(set(PARAM_REBOOT, 1));","             case Command.TYPE_SET_SPEED_LIMIT -> encodeParameters("]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01TJs7HQDXiNTpTPCajPbNYQ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
