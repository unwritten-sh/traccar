mand.TYPE_ALARM_BATTERY);\n        command.set(Command.KEY_ENABLE, false);\n        assertEquals(\"JMAK#e;57;0#\", encoder.encodeCommand(command));\n\n        command = command(Command.TYPE_ALARM_REMOVE);\n        command.set(Command.KEY_ENABLE, true);\n        assertEquals(\"JMAK#e;55;1#\", encoder.encodeCommand(command));\n\n        command = command(Command.TYPE_ALARM_VIBRATION);\n        command.set(Command.KEY_DATA, \"0\");\n        assertEquals(\"JMAK#e;59;0#\", encoder.encodeCommand(command));\n\n    }\n\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01VUYYZbmsPMChv8oYfRreKs","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
