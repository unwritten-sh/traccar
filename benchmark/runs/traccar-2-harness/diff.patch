+++ b/src/test/java/org/traccar/protocol/JmakProtocolEncoderTest.java
@@ -0,0 +1,138 @@
+package org.traccar.protocol;
+
+import org.junit.jupiter.api.Test;
+import org.traccar.ProtocolTest;
+import org.traccar.model.Command;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+public class JmakProtocolEncoderTest extends ProtocolTest {
+
+    private Command command(String type) {
+        Command command = new Command();
+        command.setDeviceId(1);
+        command.setType(type);
+        return command;
+    }
+
+    @Test
+    public void testEncodeData() throws Exception {
+
+        var encoder = inject(new JmakProtocolEncoder(null, false));
+
+        Command command = command(Command.TYPE_CUSTOM);
+        command.set(Command.KEY_DATA, "$2;60;#");
+        assertEquals("$2;60;#", encoder.encodeCommand(command));
+
+        assertEquals("$34;1;#", encoder.encodeCommand(command(Command.TYPE_ENGINE_STOP)));
+        assertEquals("$34;0;#", encoder.encodeCommand(command(Command.TYPE_ENGINE_RESUME)));
+
+        command = command(Command.TYPE_OUTPUT_CONTROL);
+        command.set(Command.KEY_INDEX, 1);
+        command.set(Command.KEY_DATA, "1");
+        assertEquals("$34;1;#", encoder.encodeCommand(command));
+        command.set(Command.KEY_INDEX, 2);
+        assertEquals("$94;1;#", encoder.encodeCommand(command));
+        command.set(Command.KEY_INDEX, 3);
+        command.set(Command.KEY_DATA, "0");
+        assertEquals("$167;0;#", encoder.encodeCommand(command));
+
+        command = command(Command.TYPE_POSITION_PERIODIC);
+        command.set(Command.KEY_FREQUENCY, 60);
+        assertEquals("$2;60;#", encoder.encodeCommand(command));
+
+        command = command(Command.TYPE_SET_ODOMETER);
+        command.set(Command.KEY_DATA, "12345");
+        assertEquals("$30;12345;#", encoder.encodeCommand(command));
+
+        command = command(Command.TYPE_SET_CONNECTION);
+        command.set(Command.KEY_SERVER, "jmak.com.br");
+        command.set(Command.KEY_PORT, 5259);
+        assertEquals("$43;jmak.com.br;|12;5259;#", encoder.encodeCommand(command));
+        command.set(Command.KEY_SERVER, "191.233.246.121");
+        assertEquals("$13;191.233.246.121;|12;5259;#", encoder.encodeCommand(command));
+
+        assertEquals("$93;1;#", encoder.encodeCommand(command(Command.TYPE_REBOOT_DEVICE)));
+
+        command = command(Command.TYPE_SET_SPEED_LIMIT);
+        command.set(Command.KEY_DATA, "80");
+        assertEquals("$16;1;|17;80;#", encoder.encodeCommand(command));
+
+        command = command(Command.TYPE_ALARM_BATTERY);
+        command.set(Command.KEY_ENABLE, false);
+        assertEquals("$57;0;#", encoder.encodeCommand(command));
+
+        command = command(Command.TYPE_ALARM_REMOVE);
+        command.set(Command.KEY_ENABLE, true);
+        assertEquals("$55;1;#", encoder.encodeCommand(command));
+
+        command = command(Command.TYPE_ALARM_VIBRATION);
+        command.set(Command.KEY_DATA, "1");
+        assertEquals("$59;1;#", encoder.encodeCommand(command));
+
+    }
+
+    @Test
+    public void testEncodeDataChannel() throws Exception {
+
+        var channel = channel(inject(new JmakProtocolEncoder(null, false)));
+
+        verifyEncode(channel, command(Command.TYPE_ENGINE_STOP), text("$34;1;#"));
+
+    }
+
+    @Test
+    public void testEncodeSms() throws Exception {
+
+        var encoder = inject(new JmakProtocolEncoder(null, true));
+
+        Command command = command(Command.TYPE_CUSTOM);
+        command.set(Command.KEY_DATA, "JMAK#s;2;60#");
+        assertEquals("JMAK#s;2;60#", encoder.encodeCommand(command));
+
+        assertEquals("JMAK#s;34;1#", encoder.encodeCommand(command(Command.TYPE_ENGINE_STOP)));
+        assertEquals("JMAK#s;34;0#", encoder.encodeCommand(command(Command.TYPE_ENGINE_RESUME)));
+
+        command = command(Command.TYPE_OUTPUT_CONTROL);
+        command.set(Command.KEY_INDEX, 2);
+        command.set(Command.KEY_DATA, "1");
+        assertEquals("JMAK#s;94;1#", encoder.encodeCommand(command));
+        command.set(Command.KEY_INDEX, 3);
+        assertEquals("JMAK#s;167;1#", encoder.encodeCommand(command));
+
+        command = command(Command.TYPE_POSITION_PERIODIC);
+        command.set(Command.KEY_FREQUENCY, 30);
+        assertEquals("JMAK#s;2;30#", encoder.encodeCommand(command));
+
+        command = command(Command.TYPE_SET_ODOMETER);
+        command.set(Command.KEY_DATA, "100");
+        assertEquals("JMAK#s;30;100#", encoder.encodeCommand(command));
+
+        command = command(Command.TYPE_SET_CONNECTION);
+        command.set(Command.KEY_SERVER, "191.233.246.121");
+        command.set(Command.KEY_PORT, 5259);
+        assertEquals("JMAK#s;13;191.233.246.121#s;12;5259#", encoder.encodeCommand(command));
+        command.set(Command.KEY_SERVER, "jmak.com.br");
+        assertEquals("JMAK#s;43;jmak.com.br#s;12;5259#", encoder.encodeCommand(command));
+
+        assertEquals("JMAK#REBOOT#", encoder.encodeCommand(command(Command.TYPE_REBOOT_DEVICE)));
+
+        command = command(Command.TYPE_SET_SPEED_LIMIT);
+        command.set(Command.KEY_DATA, "80");
+        assertEquals("JMAK#e;16;1#s;17;80#", encoder.encodeCommand(command));
+
+        command = command(Command.TYPE_ALARM_BATTERY);
+        command.set(Command.KEY_ENABLE, false);
+        assertEquals("JMAK#e;57;0#", encoder.encodeCommand(command));
+
+        command = command(Command.TYPE_ALARM_REMOVE);
+        command.set(Command.KEY_ENABLE, true);
+        assertEquals("JMAK#e;55;1#", encoder.encodeCommand(command));
+
+        command = command(Command.TYPE_ALARM_VIBRATION);
+        command.set(Command.KEY_DATA, "0");
+        assertEquals("JMAK#e;59;0#", encoder.encodeCommand(command));
+
+    }
+
+}
