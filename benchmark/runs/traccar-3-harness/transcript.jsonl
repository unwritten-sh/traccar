er(Keys.FILTER_MAX_SPEED, position.getDeviceId());\n            if (filterMaxSpeed != 0) {\n                double distance = position.getDouble(Position.KEY_DISTANCE);\n                double time = position.getFixTime().getTime() - last.getFixTime().getTime();\n                return time > 0 && UnitsConverter.knotsFromMps(distance / (time / 1000)) > filterMaxSpeed;\n            }\n        }\n        return false;\n    }\n\n    private boolean filterMinPeriod(Position position, Position last) {\n        if (last != null) {\n            long filterMinPeriod = lookupNumber(Keys.FILTER_MIN_PERIOD, position.getDeviceId()) * 1000;\n            if (filterMinPeriod != 0) {\n                long time = position.getFixTime().getTime() - last.getFixTime().getTime();\n                return time > 0 && time < filterMinPeriod;\n            }\n        }\n        return false;\n    }\n\n    private boolean filterDailyLimit(Position position, Position last) {\n        long deviceId = position.getDeviceId();\n        long filterDailyLimit = lookupNumber(Keys.FILTER_DAILY_LIMIT, deviceId);\n        int globalDailyLimit = cacheManager.getConfig().getInteger(Keys.FILTER_GLOBAL_DAILY_LIMIT);\n        if ((filterDailyLimit != 0 && statisticsManager.messageStoredCount(deviceId) >= filterDailyLimit)\n                || (globalDailyLimit > 0 && statisticsManager.messageStoredCount() >= globalDailyLimit)) {\n            long filterDailyLimitInterval = lookupNumber(Keys.FILTER_DAILY_LIMIT_INTERVAL, deviceId) * 1000;\n            long lastTime = last != null ? last.getFixTime().getTime() : 0;\n            long interval = position.getFixTime().getTime() - lastTime;\n            return filterDailyLimitInterval <= 0 || interval < filterDailyLimitInterval;\n        }\n        return false;\n    }\n\n    private boolean skipLimit(Position position, Position last) {\n        if (last != null) {\n            long skipLimit = lookupNumber(Keys.FILTER_SKIP_LIMIT, position.getDeviceId()) * 1000;\n   