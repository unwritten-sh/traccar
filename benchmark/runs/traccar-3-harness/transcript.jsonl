{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgd1ctFgqbg5qSRYjN3ho","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ue8roZhWBfrwJJCVjMysvb","name":"Write","input":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/traccar/bench/trees/traccar-3-harness/src/test/java/org/traccar/handler/FilterHandlerTest.java","content":"package org.traccar.handler;\n\nimport org.junit.jupiter.api.Test;\nimport org.traccar.BaseTest;\nimport org.traccar.config.Config;\nimport org.traccar.config.Keys;\nimport org.traccar.database.StatisticsManager;\nimport org.traccar.model.Device;\nimport org.traccar.model.Group;\nimport org.traccar.model.Position;\nimport org.traccar.session.cache.CacheManager;\n\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.Map;\n\nimport static org.junit.jupiter.api.Assertions.assertFalse;\nimport static org.junit.jupiter.api.Assertions.assertTrue;\nimport static org.mockito.ArgumentMatchers.anyLong;\nimport static org.mockito.ArgumentMatchers.eq;\nimport static org.mockito.Mockito.mock;\nimport static org.mockito.Mockito.when;\n\npublic class FilterHandlerTest extends BaseTest {\n\n    private static final long DEVICE_ID = 1;\n    private static final long OTHER_DEVICE_ID = 2;\n    private static final long GROUP_ID = 10;\n\n    private final Map<String, String> configValues = new HashMap<>();\n    private final Device device = createDevice(DEVICE_ID);\n    private final Device otherDevice = createDevice(OTHER_DEVICE_ID);\n    private final Group group = new Group();\n\n    private CacheManager cacheManager;\n    private StatisticsManager statisticsManager;\n\n    private static Device createDevice(long id) {\n        Device device = new Device();\n        device.setId(id);\n        device.setUniqueId(String.valueOf(id));\n        return device;\n    }\n\n    private FilterHandler createHandler() {\n        var config = mock(Config.class);\n        when(config.getString(org.mockito.ArgumentMatchers.anyString()))\n                .thenAnswer(invocation -> configValues.get(invocation.<String>getArgument(0)));\n        cacheManager = mock(CacheManager.class);\n        when(cacheManager.getConfig()).thenReturn(config);\n        when(cacheManager.getObject(eq(Device.class), eq(DEVICE_ID))).thenReturn(device);\n        when(cacheManager.getObject(eq(Device.class), eq(OTHER_DEVICE_ID))).thenReturn(otherDevice);\n        group.setId(GROUP_ID);\n        when(cacheManager.getObject(eq(Group.class), eq(GROUP_ID))).thenReturn(group);\n        statisticsManager = mock(StatisticsManager.class);\n        when(statisticsManager.messageStoredCount(anyLong())).thenReturn(0);\n        return new FilterHandler(cacheManager, statisticsManager);\n    }\n\n    private FilterHandler createPassingHandler() {\n        configValues.put(Keys.FILTER_FUTURE.getKey(), \"0\");\n        return createHandler();\n    }\n\n    private FilterHandler createFilteringHandler() {\n        configValues.put(Keys.FILTER_INVALID.getKey(), \"true\");\n        configValues.put(Keys.FILTER_ZERO.getKey(), \"true\");\n        configValues.put(Keys.FILTER_DUPLICATE.getKey(), \"true\");\n        configValues.put(Keys.FILTER_FUTURE.getKey(), String.valueOf(5 * 60));\n        configValues.put(Keys.FILTER_APPROXIMATE.getKey(), \"true\");\n        configValues.put(Keys.FILTER_STATIC.getKey(), \"true\");\n        configValues.put(Keys.FILTER_DISTANCE.getKey(), \"10\");\n        configValues.put(Keys.FILTER_MAX_SPEED.getKey(), \"500\");\n        configValues.put(Keys.FILTER_SKIP_LIMIT.getKey(), \"10\");\n        configValues.put(Keys.FILTER_SKIP_ATTRIBUTES.getKey(), \"alarm,result\");\n        return createHandler();\n    }\n\n    private Position createPosition(long deviceId, Date time, boolean valid, double speed) {\n        Position position = new Position();\n        position.setDeviceId(deviceId);\n        position.setTime(time);\n        position.setValid(valid);\n        position.setLatitude(10);\n        position.setLongitude(10);\n        position.setAltitude(10);\n        position.setSpeed(speed);\n        position.setCourse(10);\n        return position;\n    }\n\n    private Position createPosition(Date time, boolean valid, double speed) {\n        return createPosition(DEVICE_ID, time, valid, speed);\n    }\n\n    @Test\n    public void testFilter() {\n\n        FilterHandler filteringHandler = createFilteringHandler();\n        configValues.clear();\n        FilterHandler passingHandler = createPassingHandler();\n        // both handlers share the config map, so build them on separate configs\n        configValues.clear();\n        configValues.put(Keys.FILTER_FUTURE.getKey(), \"0\");\n\n        Position position = createPosition(new Date(), true, 10);\n        assertFalse(passingHandler.filter(position));\n        position = createPosition(new Date(Long.MAX_VALUE), true, 10);\n        assertFalse(passingHandler.filter(position));\n        position = createPosition(new Date(), false, 10);\n        assertFalse(passingHandler.filter(position));\n\n        configValues.clear();\n        filteringHandler = createFilteringHandler();\n\n        position = createPosition(new Date(), true, 10);\n        assertFalse(filteringHandler.filter(position));\n        position = createPosition(new Date(Long.MAX_VALUE), true, 10);\n        assertTrue(filteringHandler.filter(position));\n        position = createPosition(new Date(), false, 10);\n        assertTrue(filteringHandler.filter(position));\n\n    }\n\n    @Test\n    public void testSkipAttributes() {\n\n        FilterHandler filteringHandler = createFilteringHandler();\n\n        Position position = createPosition(new Date(), true, 0);\n        position.addAlarm(Position.ALARM_GENERAL);\n\n        assertFalse(filteringHandler.filter(position));\n\n    }\n\n    @Test\n    public void testFutureDefault() {\n\n        FilterHandler handler = createHandler();\n\n        assertTrue(handler.filter(createPosition(new Date(System.currentTimeMillis() + 2 * 86400_000L), true, 10)));\n        assertFalse(handler.filter(createPosition(new Date(), true, 10)));\n\n    }\n\n    @Test\n    public void testDeviceAttribute() {\n\n        FilterHandler handler = createPassingHandler();\n        device.set(Keys.FILTER_INVALID.getKey(), true);\n\n        assertTrue(handler.filter(createPosition(DEVICE_ID, new Date(), false, 10)));\n        assertFalse(handler.filter(createPosition(OTHER_DEVICE_ID, new Date(), false, 10)));\n\n    }\n\n    @Test\n    public void testDeviceAttributeOverridesConfig() {\n\n        FilterHandler handler = createFilteringHandler();\n        device.set(Keys.FILTER_INVALID.getKey(), false);\n\n        assertFalse(handler.filter(createPosition(DEVICE_ID, new Date(), false, 10)));\n        assertTrue(handler.filter(createPosition(OTHER_DEVICE_ID, new Date(), false, 10)));\n\n    }\n\n    @Test\n    public void testDeviceAttributeDisablesFutureDefault() {\n\n        FilterHandler handler = createHandler();\n        device.set(Keys.FILTER_FUTURE.getKey(), 0);\n        Date future = new Date(System.currentTimeMillis() + 2 * 86400_000L);\n\n        assertFalse(handler.filter(createPosition(DEVICE_ID, future, true, 10)));\n        assertTrue(handler.filter(createPosition(OTHER_DEVICE_ID, future, true, 10)));\n\n    }\n\n    @Test\n    public void testGroupAttribute() {\n\n        FilterHandler handler = createPassingHandler();\n        device.setGroupId(GROUP_ID);\n        group.set(Keys.FILTER_ACCURACY.getKey(), 50);\n\n        Position position = createPosition(DEVICE_ID, new Date(), true, 10);\n        position.setAccuracy(100);\n        assertTrue(handler.filter(position));\n\n        position = createPosition(OTHER_DEVICE_ID, new Date(), true, 10);\n        position.setAccuracy(100);\n        assertFalse(handler.filter(position));\n\n        device.set(Keys.FILTER_ACCURACY.getKey(), 0);\n        position = createPosition(DEVICE_ID, new Date(), true, 10);\n  